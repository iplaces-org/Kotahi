    color: var(--color-text);
    font-family: var(--font-family-primary);
    grid-column: 1 / 13;
    grid-row: 1;
    width: 100%;
}

@media only all and (min-width: 768px) {
    .modal-content__share .clipboard-container {
        grid-column: 10 / 13;
        grid-row: 1;
        justify-self: right;
