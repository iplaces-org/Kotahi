.disappearing {
    position: fixed;
    top: 0;
    width: 100%;
}
/* Tabs */

.tabbed {
	margin: 32px 0 0;
	padding-bottom: 16px;
	border-bottom: 1px solid #ccc;
  min-height:300px;
}

.tabbed [type="radio"] {
	/* hiding the inputs */
	display: none;
}

.tabs {
    background: #fff;
	display: flex;
	align-items: stretch;
	list-style: none;
	padding: 0;
    border-top: 1px solid #ccc;
	border-bottom: 1px solid #ccc;
    justify-content: center;
    position: sticky;
    top: 100px;
    z-index: 100;
}

.tab > label {
	display: block;
	padding: 12px 15px;
	color: #666;
	font-size: 12px; 
	font-weight: 600;
	text-transform: uppercase;
	letter-spacing: 1px;
	cursor: pointer;	
	transition: all 0.3s;
    white-space: nowrap;
}
.tab:hover label {
	border-top-color: #333;
	color: #333;
}

.tab-content {
	display: none;
	color: #777;
}

/* As we cannot replace the numbers with variables or calls to element properties, the number of this selector parts is our tab count limit */
.tabbed [type="radio"]:nth-of-type(1):checked ~ .tabs .tab:nth-of-type(1) label,
.tabbed [type="radio"]:nth-of-type(2):checked ~ .tabs .tab:nth-of-type(2) label,
.tabbed [type="radio"]:nth-of-type(3):checked ~ .tabs .tab:nth-of-type(3) label,
.tabbed [type="radio"]:nth-of-type(4):checked ~ .tabs .tab:nth-of-type(4) label,
.tabbed [type="radio"]:nth-of-type(5):checked ~ .tabs .tab:nth-of-type(5) label {
	background: #fff;
	color: #222;
}

.tabbed [type="radio"]:nth-of-type(1):checked ~ .tab-content:nth-of-type(1),
.tabbed [type="radio"]:nth-of-type(2):checked ~ .tab-content:nth-of-type(2),
.tabbed [type="radio"]:nth-of-type(3):checked ~ .tab-content:nth-of-type(3),
.tabbed [type="radio"]:nth-of-type(4):checked ~ .tab-content:nth-of-type(4) {
	display: block;
}

/* The Modal (background) */
.modal {
  display: none; /* Hidden by default */
  position: fixed; /* Stay in place */
  z-index: 12; /* Sit on top */
  left: 0;
  top: 0;
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  overflow: hidden; /* Enable scroll if needed */
}

/* Modal Content/Box */
.modal-content {
  background-color: #fefefe;
  margin: 0; /* 15% from the top and centered */
  padding: 40px;
  width: 60%; /* Could be more or less, depending on screen size */
}

/* The Close Button */
.close {
  color: #aaa;
  float: right;
  font-size: 34px;
  font-weight: bold;
}

.close:hover,
.close:focus {
  color: black;
  text-decoration: none;
  cursor: pointer;
}


.button {
    padding: calc(8 / var(--base-font-size)* 1rem) calc(18 / var(--base-font-size)* 1rem);
    font-size: calc(14 / var(--base-font-size)* 1rem);
    line-height: 1.7142857143;
    color: var(--color-text);
    font-family: var(--font-family-primary);
    background-color: var(--color-primary);
    border: 0;
    border-radius: 4px;
    color: #fff;
    cursor: pointer;
    display: inline-block;
    font-weight: 700;
    letter-spacing: .2px;
    text-decoration: none;
}


.button--icon-download.button--action {
    padding-right: calc(20 / var(--base-font-size)* 1rem);
    background-position-y: 8px;
}


.button--icon-download {
    padding-left: calc(41 / var(--base-font-size)* 1rem);
    background: url(../../images/download.svg) var(--color-button) no-repeat 11px 10px;
    vertical-align: middle;
}

.button--icon-citation {
    padding-left: calc(41 / var(--base-font-size)* 1rem);
    background: url(../../images/cite.svg) var(--color-button) no-repeat 11px 10px;
    vertical-align: middle;
}

.button--action {
    background-color: var(--color-button);
    color: var(--color-text);
    font-weight: 600;
    text-transform: none;
}

.button--icon-share {
    padding-left: calc(41 / var(--base-font-size)* 1rem);
    background: url(../../images/share.svg) var(--color-button) no-repeat 11px 10px;
    vertical-align: middle;
}

.article-actions__list-item {
    margin-bottom: calc(12 / var(--base-font-size)* 1rem);
    margin-right: calc(12 / var(--base-font-size)* 1rem);
    display: inline-block;
}


.modal-content__block {
    grid-column: 1 / 6;
}

.modal-content__top {
    padding-bottom: calc(24 / var(--base-font-size)* 1rem);
    display: grid;
}

.modal-content h6 {
    padding: calc(0 / var(--base-font-size)* 1rem) calc(0 / var(--base-font-size)* 1rem) calc(12 / var(--base-font-size)* 1rem);
    font-size: calc(16 / var(--base-font-size)* 1rem);
    line-height: 1.5;
    grid-column: 1 / 6;
    grid-row: 1;
    justify-self: start;
    margin: 0;
}
.modal-content__title {
    grid-column: 1 / 4;
    grid-row: 1;
    padding: 0;
}

.modal-content__close-button {
    padding: calc(0 / var(--base-font-size)* 1rem) calc(25 / var(--base-font-size)* 1rem) calc(0 / var(--base-font-size)* 1rem) calc(0 / var(--base-font-size)* 1rem);
    z-index: 20;
    font-size: calc(20 / var(--base-font-size)* 1rem);
    line-height: 1.5;
    background: url(/reviewed-preprints/_next/static/media/close.b8f8aff4.svg) right 5px no-repeat;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-family-primary);
    font-weight: 700;
    grid-row: 1;
    height: auto;
    place-self: start end;
    transform: scale(1.5);
    position: absolute;
    right: 0;
    top: 16px;
}


.modal-content__body {
    display: grid;
    grid-column: 1 / 6;
}


.form-item {
    display: grid;
    grid-column: 1 / 13;
}

@media only all and (min-width: 768px) {
    .text-field--clipboard {
        grid-column: 1 / 10;
        grid-row: 1;
    }
}
.text-field {
    font-size: calc(16 / var(--base-font-size)* 1rem);
    line-height: 1.5;
    padding: calc(11 / var(--base-font-size)* 1rem) calc(12 / var(--base-font-size)* 1rem);
    margin-bottom: calc(36 / var(--base-font-size)* 1rem);
