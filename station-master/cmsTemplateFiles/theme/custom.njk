/* =======================================================================
   iPlaces custom theme overrides.
   Loads after default.css (tokens) and elife.css (layout).
   eLife is mobile-first (base = mobile, @media min-width:768px = desktop);
   custom.css follows the same convention.
   ======================================================================= */

/* ---- MOBILE-FIRST BASE (single column) ----------------------------- */
html body #main-container {
  display: block;
  max-width: 1400px;
  margin: 0 auto;                /* centre the container */
  width: 100%;
  padding-left: 24px;            /* page gutter — plain px, no clamp */
  padding-right: 24px;
  box-sizing: border-box;
  overflow-x: hidden;            /* no child bleeds past the gutter */
}

/* ---- Global overflow guard: no sideways scroll ---------------------- */
html, body {
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ---- Align header (.topbar) + footer to the SAME gutter as content --- *
   one-column.css sets `.topbar { padding: 1em 5vh }` — 5vh is viewport-HEIGHT
   based (a vw typo), so the logo inset is wrong. Give them a normal horizontal
   gutter with border-box so padding never adds to width (no overflow). */
.topbar,
#main-footer {
  box-sizing: border-box;
  max-width: 100%;
  padding-left: 24px !important;
  padding-right: 24px !important;
}

.article-preview-header,
#article-body {
  max-width: 100%;
}
/* Kill the book-reader main sizing (one-column.css) for the article layout,
   at every screen size — it otherwise forces main to 90vw / 70rem and breaks
   the gutter and the two-column row. */
#article-body main {
  width: auto;
  max-width: 100%;
  padding-left: 0;
  padding-right: 0;
}
aside {
  width: 100%;
  position: static;
  background-color: white;
}

/* ---- Mobile: main content and stacked sidebar share ONE left edge ---- *
   Below the two-column breakpoint the abstract/tab content and the sidebar
   were landing at different left insets. Zero the inner horizontal padding so
   both sit flush to #main-container's gutter. */
@media (max-width: 767px) {
  #article-body {
    display: block;
  }
  #article-body main,
  #article-body aside,
  .article-content,
  .tab-content,
  .tabbed {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  #article-body aside {
    border-left: 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
    position: static !important;
    left: auto !important;
  }
  /* The Abstract TOC rail (.meta-data > aside.toc-wrapper) sits inside main but
     breaks to left:0 on mobile — pull it back to the content edge. */
  .article-content {
    display: block !important;
  }
  .meta-data,
  .toc-wrapper {
    margin-left: 0 !important;
    padding-left: 0 !important;
    left: auto !important;
    position: static !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
}

/* ---- TOC link visibility ------------------------------------------- *
   Forces the TOC (aside.toc-wrapper) links visible against color,
   opacity, and visibility. --color-primary from default.css; #087cca
   is the fallback. !important is belt-and-suspenders while an unknown
   override may still be live. */
.toc-wrapper a {
  color: var(--color-primary, #087cca) !important;
  opacity: 1 !important;
  visibility: visible !important;
}
.toc-wrapper a:hover {
  text-decoration: underline;
}

/* ---- DESKTOP (>=768px): header full-width, body two-column --------- *
   The header spans the top; #article-body is the flex row that holds
   the tabs (main) and the sidebar (aside). The sidebar top-aligns to
   the tabs via the flex parent — NO magic margin-top shim. */
@media (min-width: 768px) {
  html body #main-container {
    display: block;
    padding-left: 48px;
    padding-right: 48px;
  }
  .topbar,
  #main-footer {
    padding-left: 48px !important;
    padding-right: 48px !important;
  }
  /* one-column.css sets `main { width: clamp(16rem,90vw,70rem); padding: 1.5rem }`
     for its book reader — that fights the two-column article layout and causes the
     squish/edge problems. Neutralise it inside #article-body. */
  #article-body main {
    width: auto !important;
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .article-preview-header {
    width: 100%;
    margin-bottom: 1.5rem;
  }
  #article-body {
    display: flex;
    gap: 3.5rem;
    align-items: flex-start;
  }
  #article-body main {
    flex: 1 1 auto;
    min-width: 0;
  }
  aside {
    align-self: flex-start;
    position: sticky;
    top: 20px;
    width: 32%;
    flex: 0 0 32%;
    height: fit-content;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    overflow-x: hidden;
    padding-left: 1.5rem;
    padding-right: 0.5rem;
    border-left: 1px solid #ececec;
    box-sizing: border-box;
    z-index: 11;
  }
}

/* =======================================================================
   ARTICLE PAGE DECLUTTER (2026-07-15)
   Compact action buttons, tightened sidebar, Details block styling.
   Overrides elife.css (which loads earlier).
   ======================================================================= */

/* ---- Compact action buttons: smaller, lighter, inline row ---------- */
.article-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 0;
  margin: 0;
  list-style: none;
}
.article-actions__list-item {
  margin: 0 !important;
  display: inline-block;
}
.article-actions .button--action {
  padding: 6px 12px 6px 32px !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  line-height: 1.3 !important;
  background-color: transparent !important;
  color: var(--color-primary, #0470c0) !important;
  border: 1px solid var(--divider, #d5d5d5) !important;
  border-radius: 6px !important;
}
.article-actions .button--action:hover {
  background-color: #f4f7fa !important;
}
.article-actions .button--icon-citation {
  background: url(../../images/cite.svg) transparent no-repeat 9px 7px !important;
  background-size: 15px !important;
}
.article-actions .button--icon-share {
  background: url(../../images/share.svg) transparent no-repeat 9px 7px !important;
  background-size: 15px !important;
}
.article-actions .button--icon-download {
  background: url(../../images/download.svg) transparent no-repeat 9px 7px !important;
  background-size: 15px !important;
}

/* ---- Tighten the sidebar ------------------------------------------- */
.review-timeline-container,
.article-actions-container {
  margin-left: 0 !important;
  margin-right: 0 !important;
}
.review-timeline__event {
  width: auto !important;
  font-size: 15px !important;
  height: auto !important;
}
aside hr {
  border: 0;
  border-top: 1px solid #ececec;
  margin: 16px 0;
}
#zenodo-button.button--action {
  padding: 7px 14px !important;
  font-size: 13px !important;
  background-color: transparent !important;
  color: var(--color-primary, #0470c0) !important;
  border: 1px solid var(--divider, #d5d5d5) !important;
  border-radius: 6px !important;
}
#zenodo-button.button--action:hover {
  background-color: #f4f7fa !important;
}
.related-works {
  list-style: none;
  padding: 0;
  margin: 0;
  font-size: 13px;
  line-height: 1.4;
}
.related-works li {
  margin-bottom: 8px;
}

/* ---- Collapsible affiliations (Cell-style disclosure) -------------- */
#affiliations-details {
  margin: 0.4rem 0 0.2rem;
}
#affiliations-details > summary {
  cursor: pointer;
  font-size: 13px;
  color: var(--color-primary, #0470c0);
  font-weight: 600;
  list-style: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  user-select: none;
}
#affiliations-details > summary::-webkit-details-marker { display: none; }
#affiliations-details > summary::after {
  content: "\25BE";
  font-size: 11px;
  transition: transform 0.15s;
}
#affiliations-details[open] > summary::after { transform: rotate(180deg); }
#affiliations-list {
  margin: 8px 0 0;
  padding-left: 1.3rem;
  font-size: 13px;
  color: #666;
  line-height: 1.5;
}
#affiliations-list li { margin: 0; }

/* ---- Understate the header DOI / metadata lines -------------------- */
.header-doi-and-licenses a,
.published-date {
  font-size: 13px;
  color: #8a8a83;
}

/* ---- About-this-[type] consolidated metadata block ---------------- */
.about-this-meta {
  margin-top: 10px !important;
  font-size: 13px;
  line-height: 1.6;
  color: #212121;
  font-weight: 400;
}
/* every value row: dark, normal weight */
.about-this-meta .about-block,
.about-this-meta .about-published {
  font-weight: 400;
  color: #212121;
}
/* one uniform label treatment for all rows */
.about-meta-label {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #78716c;
  font-weight: 600;
  margin-bottom: 5px;
}
.about-block {
  margin-top: 20px;
}
.about-published {
  color: #8a8a83;               /* date is muted, no label */
}
/* links: coloured but never bold, so values don't shout */
.about-this-meta a {
  color: var(--color-primary, #0470c0);
  font-weight: 400;
  word-break: break-word;
}
.about-this-meta .about-doi a {
  color: #8a8a83;               /* DOI value muted grey */
}
.about-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.about-list li {
  margin-bottom: 8px;
  line-height: 1.55;
  color: #212121;
}
.about-value {
  color: #212121;
}
.contrib-type {
  color: #8a8a83;
  font-size: 12px;
}

/* ---- Contributors under the byline (header) ----------------------- */
.contributors-inline {
  margin: 4px 0 2px;
  font-size: 13px;
  color: #57534e;
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}
.contributors-inline__label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #78716c;
  font-weight: 600;
  flex: 0 0 auto;
}
.contributors-inline__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: inline-flex;
  flex-wrap: wrap;
  gap: 4px 14px;
}
.contributors-inline__list li {
  margin: 0;
  color: #333;
}

/* ---- ROR badge (links to DataCite Commons ror record) ------------- */
.ror-link {
  display: inline-block;
  vertical-align: middle;
  margin-left: 7px;
  line-height: 0;
  white-space: nowrap;
}
.ror-logo {
  height: 14px;
  width: auto;
  vertical-align: middle;
  opacity: 0.85;
}
.ror-link:hover .ror-logo {
  opacity: 1;
}

/* ---- Abstract-only / no-TOC records go full-width ------------------ *
   full-text.njk adds .no-toc when there's no body content to navigate.
   Collapse the grid so the article uses the full column width instead of
   sitting in the right cell with an empty rail beside it. */
.article-preview .article-content.no-toc,
.article-content.no-toc {
  display: block !important;
  grid-template-columns: none !important;
}
.article-content.no-toc > article {
  width: 100%;
  max-width: 100%;
}