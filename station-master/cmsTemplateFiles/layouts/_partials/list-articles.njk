<style>
  body.section-latest .page-content { padding-left: 0 !important; padding-right: 0 !important; }
  .iplaces-journal { width: 100%; max-width: 720px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .iplaces-journal .issue { margin: 0 0 2.75rem; }
  .iplaces-journal .issue-label {
    font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: #6b6b63; margin: 0 0 0.15rem;
  }
  .iplaces-journal .issue-year {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem; font-weight: 600; line-height: 1; margin: 0 0 1.1rem;
    padding-bottom: 0.55rem; border-bottom: 2px solid #1b1b1a; color: #1b1b1a;
  }
  .iplaces-journal .issue-past .issue-year { font-size: 1.45rem; border-bottom-width: 1px; }
  .iplaces-journal .toc { list-style: none; margin: 0; padding: 0; }
  .iplaces-journal .toc-item { padding: 0.9rem 0; border-bottom: 1px solid #e9e7df; }
  .iplaces-journal .toc-item:last-child { border-bottom: none; }
  .iplaces-journal .toc-title {
    display: block; font-size: 1.08rem; font-weight: 600; line-height: 1.35;
    color: #1b1b1a; text-decoration: none;
  }
  .iplaces-journal .toc-title:hover { text-decoration: underline; }
  .iplaces-journal .toc-authors { display: block; font-size: 0.9rem; color: #57574f; margin-top: 0.25rem; }
  .iplaces-journal .tag {
    float: right; margin: 0.15rem 0 0 0.75rem; font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 3px;
    white-space: nowrap;
  }
  .iplaces-journal .tag-class    { background: #f3ecd8; color: #7a5410; }
  .iplaces-journal .tag-research { background: #e6f1fb; color: #185fa5; }
  .iplaces-journal .tag-conf     { background: #ece4f5; color: #5a3a86; }
  .iplaces-journal .tag-outreach { background: #e1f5ee; color: #0f6e56; }
  .iplaces-journal .tag-science     { background: #e6f1fb; color: #185fa5; }
  .iplaces-journal .tag-culture     { background: #fbe9e2; color: #9a3412; }
  .iplaces-journal .tag-education   { background: #f3ecd8; color: #7a5410; }
  .iplaces-journal .tag-stewardship { background: #e1f5ee; color: #0f6e56; }
  .iplaces-journal .tag-compliance  { background: #ecebe6; color: #45453f; }
  .iplaces-journal .archive-head {
    font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: #6b6b63;
    margin: 3.5rem 0 1.75rem; padding-top: 1.5rem; border-top: 2px solid #1b1b1a;
  }
  .iplaces-filters { width: 100%; max-width: 720px; margin: 2.5rem auto 0; padding: 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .iplaces-filters button {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.35rem 0.8rem; border-radius: 999px; border: 1px solid #cfccc3;
    background: #fff; color: #57574f; cursor: pointer;
  }
  .iplaces-filters button.active { background: #1b1b1a; color: #fff; border-color: #1b1b1a; }
  .iplaces-journal .issue.is-hidden, .iplaces-journal .archive-head.is-hidden, .iplaces-journal .toc-item.is-hidden { display: none; }
  @media (max-width: 700px) { .iplaces-journal { padding: 1.5rem 1.1rem 3rem; } .iplaces-filters { padding: 0 1.1rem; } }
</style>
{#- Home page filters and record tags. A station can set its own list as
    "homeFilters" in data/station.json (via station-master/manifest.json):
    [{"key", "label", "tokens"?: [...], "cls"?}]. A record gets the first
    filter whose key or any token appears in its topics. Without it, the
    original four (Class, Research, Conference/Workshop, Outreach) apply. -#}
{%- set homeFilters = station.homeFilters if (station.homeFilters and station.homeFilters.length) else [
  {"key": "class", "label": "Class"},
  {"key": "research", "label": "Research"},
  {"key": "conference", "label": "Conference/Workshop", "tokens": ["conference", "workshop"], "cls": "conf"},
  {"key": "outreach", "label": "Outreach"}
] -%}
<div class="iplaces-filters" role="group" aria-label="Filter records by type">
  <button type="button" data-filter="all" class="active" aria-pressed="true" aria-controls="iplaces-journal">All</button>
{%- for f in homeFilters %}
  <button type="button" data-filter="{{ f.key }}" aria-pressed="false" aria-controls="iplaces-journal">{{ f.label }}</button>
{%- endfor %}
</div><div class="iplaces-journal" id="iplaces-journal">{% set kept = [] %}{% for a in articleQuery.articles %}{% if not (station.hideConferencePapers and ('ConferencePaper' in a.submission)) %}{% set _ = kept.push(a) %}{% endif %}{% endfor %}{% set sortedArticles = kept | sort(true, false, 'parsedSubmission.datePublished') %}{% if sortedArticles.length > 0 %}{% set currentYear = sortedArticles[0].parsedSubmission.datePublished %}{% for article in sortedArticles %}    {% set y = article.parsedSubmission.datePublished %}    {% set prevY = "" %}    {% if not loop.first %}{% set prevY = sortedArticles[loop.index0 - 1].parsedSubmission.datePublished %}{% endif %}    {% set nextY = "" %}    {% if not loop.last %}{% set nextY = sortedArticles[loop.index0 + 1].parsedSubmission.datePublished %}{% endif %}    {% if y != currentYear and prevY == currentYear %}        <p class="archive-head">Archives</p>    {% endif %}    {% if y != prevY %}        <section class="issue {% if y != currentYear %}issue-past{% endif %}">            {% if y == currentYear %}<p class="issue-label">Current issue</p>{% endif %}            <h2 class="issue-year">{{ y }}</h2>            <ol class="toc">    {% endif %}            {% set type = (article.parsedSubmission.topics if article.parsedSubmission else "") | string | lower %}{% if not type and ('ConferencePaper' in article.submission) %}{% set type = "conference" %}{% endif %}            {% set filterkey = "" %}{% set tag = null %}{% for f in homeFilters %}{% if not tag %}{% for tok in (f.tokens or [f.key]) %}{% if not tag and (tok | lower) in type %}{% set tag = f %}{% endif %}{% endfor %}{% endif %}{% endfor %}{% if tag %}{% set filterkey = tag.key %}{% endif %}            <li class="toc-item" data-type="{{ filterkey }}">                {% if tag %}<span class="tag tag-{{ tag.cls or tag.key }}">{{ tag.label }}</span>{% endif %}                <a class="toc-title" href="{{ cmsConfig.defaultArticleDirectory }}{{ article.shortId }}/index.html">{{ article.headerInfo.title | safe }}</a>                <span class="toc-authors">{% for a in article.headerInfo.authorNames %}{{ a.firstName }} {{ a.lastName }}{% if not loop.last %}, {% endif %}{% endfor %}</span>            </li>    {% if y != nextY %}            </ol>        </section>    {% endif %}{% endfor %}{% else %}    <p>No articles published yet.</p>{% endif %}</div>
<script>(function () {
  var buttons = document.querySelectorAll('.iplaces-filters button');
  var journal = document.querySelector('.iplaces-journal');
  if (!buttons.length || !journal) return;
  function apply(filter) {
    journal.querySelectorAll('.toc-item').forEach(function (item) {
      var match = filter === 'all' || item.getAttribute('data-type') === filter;
      item.classList.toggle('is-hidden', !match);
    });
    journal.querySelectorAll('.issue').forEach(function (issue) {
      var anyVisible = issue.querySelectorAll('.toc-item:not(.is-hidden)').length > 0;
      issue.classList.toggle('is-hidden', !anyVisible);
    });
    var archiveHead = journal.querySelector('.archive-head');
    if (archiveHead) {
      var pastVisible = journal.querySelectorAll('.issue-past:not(.is-hidden)').length > 0;
      archiveHead.classList.toggle('is-hidden', !pastVisible);
    }
  }
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      buttons.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      apply(btn.getAttribute('data-filter'));
    });
  });
})();</script>