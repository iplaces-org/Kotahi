 <style>
  body.section-latest .page-content { padding-left: 0 !important; padding-right: 0 !important; }
  .gump-journal { max-width: 720px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .gump-journal .issue { margin: 0 0 2.75rem; }
  .gump-journal .issue-label {
    font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: #7a7a72; margin: 0 0 0.15rem;
  }
  .gump-journal .issue-year {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem; font-weight: 600; line-height: 1; margin: 0 0 1.1rem;
    padding-bottom: 0.55rem; border-bottom: 2px solid #1b1b1a; color: #1b1b1a;
  }
  .gump-journal .issue-past .issue-year { font-size: 1.45rem; border-bottom-width: 1px; }
  .gump-journal .toc { list-style: none; margin: 0; padding: 0; }
  .gump-journal .toc-item { padding: 0.9rem 0; border-bottom: 1px solid #e9e7df; }
  .gump-journal .toc-item:last-child { border-bottom: none; }
  .gump-journal .toc-title {
    display: block; font-size: 1.08rem; font-weight: 600; line-height: 1.35;
    color: #1b1b1a; text-decoration: none;
  }
  .gump-journal .toc-title:hover { text-decoration: underline; }
  .gump-journal .toc-authors { display: block; font-size: 0.9rem; color: #57574f; margin-top: 0.25rem; }
  .gump-journal .geome-badge {
    float: right; margin: 0.15rem 0 0 0.75rem; font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 3px;
    white-space: nowrap; background: #e1f0f5; color: #0a5e7a;
  }
  .gump-journal .archive-head {
    font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: #7a7a72;
    margin: 3.5rem 0 1.75rem; padding-top: 1.5rem; border-top: 2px solid #1b1b1a;
  }
  .gump-journal .intro {
    font-size: 0.95rem; color: #57574f; margin: 0 0 2rem;
    padding-bottom: 1.5rem; border-bottom: 1px solid #e9e7df;
  }
  @media (max-width: 700px) { .gump-journal { padding: 1.5rem 1.1rem 3rem; } }
</style>

<div class="gump-journal">
  <p class="intro">Articles with associated field collecting records in the <a href="https://geome-db.org" target="_blank" rel="noopener">Genomic Observatories Metadatabase (GEOME)</a>.</p>

{% if articleQuery.articles.length > 0 %}
{% set sortedArticles = articleQuery.articles | sort(true, false, 'parsedSubmission.datePublished') %}
{% set currentYear = sortedArticles[0].parsedSubmission.datePublished %}

{# ── collect only articles that have a GEOME URL ── #}
{% set geomeArticles = [] %}
{% for article in sortedArticles %}
  {% if article.parsedSubmission.GEOME and article.parsedSubmission.GEOME[0] and article.parsedSubmission.GEOME[0].url %}
    {% set geomeArticles = (geomeArticles.push(article), geomeArticles) %}
  {% endif %}
{% endfor %}

{% if geomeArticles.length > 0 %}
  {% set prevY = "" %}
  {% for article in geomeArticles %}
    {% set y = article.parsedSubmission.datePublished %}
    {% set nextY = "" %}
    {% if not loop.last %}{% set nextY = geomeArticles[loop.index0 + 1].parsedSubmission.datePublished %}{% endif %}

    {% if y != prevY %}
      {% if not loop.first %}</ol></section>{% endif %}
      {% if prevY == currentYear and y != currentYear %}
        <p class="archive-head">Archives</p>
      {% endif %}
      <section class="issue {% if y != currentYear %}issue-past{% endif %}">
        {% if y == currentYear %}<p class="issue-label">Current issue</p>{% endif %}
        <h2 class="issue-year">{{ y }}</h2>
        <ol class="toc">
    {% endif %}

    <li class="toc-item">
      <span class="geome-badge">GEOME</span>
      <a class="toc-title" href="{{ cmsConfig.defaultArticleDirectory }}{{ article.shortId }}/index.html">{{ article.headerInfo.title | safe }}</a>
      <span class="toc-authors">
        {% for a in article.headerInfo.authorNames %}{{ a.firstName }} {{ a.lastName }}{% if not loop.last %}, {% endif %}{% endfor %}
      </span>
    </li>

    {% set prevY = y %}
    {% if loop.last %}</ol></section>{% endif %}
  {% endfor %}
{% else %}
  <p>No articles with GEOME field records yet.</p>
{% endif %}

{% else %}
  <p>No articles published yet.</p>
{% endif %}
</div> 