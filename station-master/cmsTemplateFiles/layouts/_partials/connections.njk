{# Connections: every related work we can find for this record, merged and de-duplicated:
   1. the record's own form data (related identifiers, related DOIs, GEOME), so links
      show even before DataCite has them, for test DOIs, and for records with no DOI;
   2. the DataCite REST record (relatedIdentifiers, relatedItems with an identifier);
   3. other DataCite records that point at this DOI (any relation type, shown inverted);
   4. DataCite event data (links from Crossref and other sources, both directions);
   5. the DataCite GraphQL graph (part of, parts, references, citations, versions). #}
{% set ps = article.parsedSubmission %}
{% set apiDoi = ps.$doi if (ps.$doi and not ps.$doiIsTest) else '' %}
{% set localRel = { "relatedIdentifiers": ps.relatedIdentifiers or [], "dois": ps.$dois or [], "geome": ps.GEOME or [] } %}
{% if apiDoi or (ps.relatedIdentifiers and ps.relatedIdentifiers.length) or (ps.$dois and ps.$dois.length) or (ps.GEOME and ps.GEOME[0] and ps.GEOME[0].url) %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>

<section id="datacite-connections" class="dc-connections" data-doi="{{ apiDoi }}" data-title="{{ article.headerInfo.title | striptags }}">
  <script type="application/json" class="dc-local">{{ localRel | dump | replace("<", "\\u003c") | safe }}</script>
  <p class="dc-connections-intro">Works connected to this record, from its own metadata and from DataCite. Click a bubble to open it.</p>
  <p class="dc-connections-loading">Loading connections…</p>
  <div class="dc-connections-empty" style="display:none;">No connections registered for this record yet.</div>
  <div class="dc-graph-wrap"><svg class="dc-graph" viewBox="0 0 700 440" preserveAspectRatio="xMidYMid meet" aria-label="Connections graph"></svg></div>
  <div class="dc-connections-body"></div>
  {% if apiDoi %}<p class="dc-connections-foot">
    <a class="dc-commons-link" href="https://commons.datacite.org/doi.org/{{ apiDoi }}" target="_blank" rel="noopener">View full connection graph on DataCite Commons →</a>
  </p>{% endif %}
</section>

<style>
  .dc-connections { max-width: 760px; margin: 0 auto; }
  .dc-connections-intro { font-size: 0.85rem; color: #6b6b63; margin: 0 0 1rem; }
  .dc-connections-loading { font-size: 0.85rem; color: #6b6b63; font-style: italic; }
  .dc-connections-empty { font-size: 0.9rem; color: #6b6b63; padding: 1rem 0; }
  .dc-graph-wrap { width: 100%; margin: 0 0 1.5rem; }
  .dc-graph { width: 100%; height: auto; display: block; }
  .dc-graph .dc-node { cursor: pointer; }
  .dc-graph .dc-node circle { stroke: #fff; stroke-width: 2px; transition: opacity 0.15s; }
  .dc-graph .dc-node:hover circle { opacity: 0.8; }
  .dc-graph .dc-center circle { stroke: #1b1b1a; stroke-width: 2.5px; }
  .dc-graph text { font-family: -apple-system, system-ui, sans-serif; fill: #1b1b1a; pointer-events: none; }
  .dc-graph line { stroke: #cfccc3; stroke-width: 1.5px; }
  .dc-connections .dc-group { margin: 0 0 1.25rem; }
  .dc-connections .dc-group-head { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: #57574f; font-weight: 700; margin: 0 0 0.6rem; }
  .dc-connections .dc-group-head .dc-count { background: #1b1b1a; color: #fff; border-radius: 999px; padding: 0.05rem 0.5rem; margin-left: 0.4rem; font-size: 0.68rem; }
  .dc-connections ul { list-style: none; margin: 0; padding: 0; }
  .dc-connections li { padding: 0.7rem 0; border-bottom: 1px solid #e9e7df; }
  .dc-connections li:last-child { border-bottom: none; }
  .dc-connections .dc-rel-title { display: block; font-size: 1rem; font-weight: 600; line-height: 1.35; color: #1b1b1a; text-decoration: none; }
  .dc-connections .dc-rel-title:hover { text-decoration: underline; }
  .dc-connections .dc-rel-meta { display: block; font-size: 0.8rem; color: #6b6b63; margin-top: 0.2rem; }
  .dc-connections .dc-type-badge { display: inline-block; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; padding: 0.15rem 0.45rem; border-radius: 3px; margin-right: 0.4rem; }
  .dc-connections-foot { margin-top: 0.5rem; font-size: 0.9rem; }
</style>

<script>
(function () {
  var section = document.getElementById('datacite-connections');
  if (!section) return;
  var doi = section.getAttribute('data-doi') || '';
  var local = {};
  try { local = JSON.parse((section.querySelector('.dc-local') || {}).textContent || '{}') || {}; } catch (e) { local = {}; }

  var TYPE_COLORS = {
    'Dataset': '#0f6e56', 'Text': '#185fa5', 'Event': '#c2479b', 'Collection': '#7a5410',
    'Software': '#5a3a86', 'Other': '#6b6b63', 'JournalArticle': '#185fa5', 'PhysicalObject': '#0f6e56'
  };
  function colorFor(t) { return TYPE_COLORS[t] || '#6b6b63'; }

  var REL = [
    { key: 'partOf', rel: 'IsPartOf' }, { key: 'parts', rel: 'HasPart' },
    { key: 'references', rel: 'References' }, { key: 'citations', rel: 'IsCitedBy' },
    { key: 'versionOf', rel: 'IsVersionOf' }, { key: 'versions', rel: 'HasVersion' }
  ];
  var nodeFields = 'totalCount nodes { id titles { title } types { resourceTypeGeneral } }';
  var query = 'query($id: ID!) { work(id: $id) {'
    + REL.map(function (r) { return ' ' + r.key + ': ' + r.key + ' { ' + nodeFields + ' }'; }).join('')
    + ' } }';

  // DataCite relation types; keys are lower case without hyphens so
  // "IsPartOf" (metadata) and "is-part-of" (event data) land in one group.
  var REL_LABELS = {
    ispartof: 'Part of', haspart: 'Has part', references: 'References', isreferencedby: 'Referenced by',
    cites: 'Cites', iscitedby: 'Cited by', isversionof: 'Version of', hasversion: 'Has version',
    issupplementto: 'Supplement to', issupplementedby: 'Supplemented by', isderivedfrom: 'Derived from',
    issourceof: 'Source of', isdocumentedby: 'Documented by', documents: 'Documents',
    isdescribedby: 'Described by', describes: 'Describes', isnewversionof: 'New version of',
    ispreviousversionof: 'Previous version of', iscontinuedby: 'Continued by', continues: 'Continues',
    isidenticalto: 'Identical to', isvariantformof: 'Variant form of', isoriginalformof: 'Original form of',
    iscompiledby: 'Compiled by', compiles: 'Compiles', isreviewedby: 'Reviewed by', reviews: 'Reviews',
    requires: 'Requires', isrequiredby: 'Required by', obsoletes: 'Obsoletes', isobsoletedby: 'Obsoleted by',
    ispublishedin: 'Published in', publishes: 'Publishes', iscollectedby: 'Collected by', collects: 'Collects',
    hastranslation: 'Has translation', istranslationof: 'Translation of', ismetadatafor: 'Metadata for',
    hasmetadata: 'Has metadata', isrelatedto: 'Related to', hassample: 'Samples'
  };
  // When another record says "X <rel> this", this record has the inverse.
  var INVERSE = {
    ispartof: 'haspart', haspart: 'ispartof', references: 'isreferencedby', isreferencedby: 'references',
    cites: 'iscitedby', iscitedby: 'cites', isversionof: 'hasversion', hasversion: 'isversionof',
    issupplementto: 'issupplementedby', issupplementedby: 'issupplementto', isderivedfrom: 'issourceof',
    issourceof: 'isderivedfrom', isdocumentedby: 'documents', documents: 'isdocumentedby',
    isdescribedby: 'describes', describes: 'isdescribedby', isnewversionof: 'ispreviousversionof',
    ispreviousversionof: 'isnewversionof', iscontinuedby: 'continues', continues: 'iscontinuedby',
    isidenticalto: 'isidenticalto', isvariantformof: 'isoriginalformof', isoriginalformof: 'isvariantformof',
    iscompiledby: 'compiles', compiles: 'iscompiledby', isreviewedby: 'reviews', reviews: 'isreviewedby',
    requires: 'isrequiredby', isrequiredby: 'requires', obsoletes: 'isobsoletedby', isobsoletedby: 'obsoletes',
    ispublishedin: 'publishes', publishes: 'ispublishedin', iscollectedby: 'collects', collects: 'iscollectedby',
    hastranslation: 'istranslationof', istranslationof: 'hastranslation', ismetadatafor: 'hasmetadata',
    hasmetadata: 'ismetadatafor', isrelatedto: 'isrelatedto'
  };
  function relKey(t) { return (t || 'isrelatedto').toLowerCase().replace(/[^a-z]/g, ''); }
  function relLabel(k) { return REL_LABELS[k] || k || 'Related to'; }

  function bareDoi(id) { return (id || '').trim().replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').replace(/^doi:/i, ''); }
  function looksLikeDoi(id) { return /^10\.\d{4,9}\//.test(bareDoi(id)); }
  function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function truncate(s, n) { s = s || ''; return s.length > n ? s.slice(0, n - 1) + '…' : s; }

  var loading = section.querySelector('.dc-connections-loading');
  var empty = section.querySelector('.dc-connections-empty');
  var graphWrap = section.querySelector('.dc-graph-wrap');

  var API = 'https://api.datacite.org';
  function getJSON(u, opts) {
    return fetch(u, opts).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; });
  }
  // Title and type of a DOI: DataCite first, then Crossref (journal articles)
  var lookups = {};
  function lookupDoi(d) {
    var k = d.toLowerCase();
    if (lookups[k]) return lookups[k];
    lookups[k] = getJSON(API + '/dois/' + encodeURIComponent(d)).then(function (j) {
      var a = j && j.data && j.data.attributes;
      if (a) return { title: (a.titles && a.titles[0] && a.titles[0].title) || d, type: (a.types && a.types.resourceTypeGeneral) || 'Other', datacite: true };
      return getJSON('https://api.crossref.org/works/' + encodeURIComponent(d)).then(function (c) {
        var m = c && c.message;
        if (!m) return { title: d, type: 'Other', datacite: false };
        var type = m.type === 'journal-article' ? 'JournalArticle' : (m.type === 'dataset' ? 'Dataset' : 'Text');
        return { title: (m.title && m.title[0]) || d, type: type, datacite: false };
      });
    });
    return lookups[k];
  }
  function hrefFor(idType, raw, id, datacite) {
    if (idType === 'doi') return datacite ? 'https://commons.datacite.org/doi.org/' + id : 'https://doi.org/' + id;
    if (/^https?:\/\//i.test(raw)) return raw;
    if (idType === 'handle') return 'https://hdl.handle.net/' + raw;
    if (idType === 'ark') return 'https://n2t.net/' + raw;
    if (idType === 'pmid') return 'https://pubmed.ncbi.nlm.nih.gov/' + raw;
    if (idType === 'arxiv') return 'https://arxiv.org/abs/' + raw.replace(/^arxiv:/i, '');
    if (idType === 'isbn') return 'https://openlibrary.org/isbn/' + raw.replace(/[^0-9Xx]/g, '');
    if (idType === 'igsn') return 'https://igsn.org/' + raw;
    return '';
  }

  // ---- collect: one entry per (relation, identifier) ----
  var self = bareDoi(doi).toLowerCase();
  var groups = {}, order = [], seen = {}, items = [];
  function add(relType, raw, idType, extra) {
    raw = String(raw || '').trim();
    if (!raw) return;
    idType = (idType || (looksLikeDoi(raw) ? 'DOI' : (/^https?:\/\//i.test(raw) ? 'URL' : ''))).toString();
    var isDoi = idType.toLowerCase() === 'doi' || (idType === 'URL' && looksLikeDoi(raw) && /doi\.org\//i.test(raw));
    var id = isDoi ? bareDoi(raw) : raw;
    var key = id.toLowerCase();
    if (!key || key === self) return;
    var rk = relKey(relType);
    var label = relLabel(rk);
    if (seen[label + '|' + key]) {
      var prev = seen[label + '|' + key];
      if (extra && extra.title && prev.title === prev.id) prev.title = extra.title;
      if (extra && extra.type && prev.type === 'Other') prev.type = extra.type;
      return;
    }
    var it = {
      key: key, id: id, isDoi: isDoi, idType: isDoi ? 'DOI' : idType,
      title: (extra && extra.title) || id, type: (extra && extra.type) || 'Other',
      href: (extra && extra.href) || hrefFor(isDoi ? 'doi' : idType.toLowerCase(), raw, id, false),
      needsLookup: isDoi && !(extra && extra.title)
    };
    seen[label + '|' + key] = it;
    if (!groups[label]) { groups[label] = []; order.push(label); }
    groups[label].push(it);
    items.push(it);
  }

  // 1. the record's own form data (built into the page)
  (local.relatedIdentifiers || []).forEach(function (r) {
    if (r) add(r.relationType, r.relatedIdentifier, r.relatedIdentifierType, { type: r.resourceTypeGeneral });
  });
  (local.dois || []).forEach(function (r) { if (r && r.doi) add('HasPart', r.doi, 'DOI'); });
  (local.geome || []).forEach(function (g) {
    if (g && g.url) add('HasSample', g.url, 'URL', { title: g.title || g.name || 'Field collecting records (GEOME)', type: 'PhysicalObject' });
  });

  var jobs = [];
  if (doi) {
    // 2. this record on DataCite: relatedIdentifiers + relatedItems
    jobs.push(getJSON(API + '/dois/' + encodeURIComponent(doi)).then(function (j) {
      var a = (j && j.data && j.data.attributes) || {};
      (a.relatedIdentifiers || []).forEach(function (ri) {
        add(ri.relationType, ri.relatedIdentifier, ri.relatedIdentifierType, { type: ri.resourceTypeGeneral });
      });
      (a.relatedItems || []).forEach(function (ri) {
        var idf = ri.relatedItemIdentifier || {};
        if (!idf.relatedItemIdentifier) return;
        var t = ri.titles && ri.titles[0] && ri.titles[0].title;
        add(ri.relationType, idf.relatedItemIdentifier, idf.relatedItemIdentifierType, { title: t, type: ri.relatedItemType });
      });
    }));

    // 3. other DataCite records that point at this DOI
    var q = ['"' + bareDoi(doi) + '"', '"https://doi.org/' + bareDoi(doi) + '"'];
    if (bareDoi(doi) !== bareDoi(doi).toLowerCase()) q.push('"' + bareDoi(doi).toLowerCase() + '"');
    var inboundQuery = q.map(function (v) { return 'relatedIdentifiers.relatedIdentifier:' + v; }).join(' OR ');
    jobs.push(getJSON(API + '/dois?query=' + encodeURIComponent(inboundQuery) + '&page[size]=100').then(function (j) {
      ((j && j.data) || []).forEach(function (d) {
        var a = d.attributes || {};
        var other = a.doi || d.id;
        var title = (a.titles && a.titles[0] && a.titles[0].title) || other;
        var type = (a.types && a.types.resourceTypeGeneral) || 'Other';
        var info = { title: title, type: type, href: 'https://commons.datacite.org/doi.org/' + other };
        var matched = false;
        (a.relatedIdentifiers || []).forEach(function (ri) {
          var rid = String(ri.relatedIdentifier || '').toLowerCase();
          if (bareDoi(rid) !== self && rid.indexOf(self) === -1) return;
          matched = true;
          add(INVERSE[relKey(ri.relationType)] || 'isrelatedto', other, 'DOI', info);
        });
        // The Related works box lists every record this search returns, so the
        // tab does too, even when we can't tell which of its links matched.
        if (!matched) add('isrelatedto', other, 'DOI', info);
      });
    }));

    // 4. DataCite event data (Crossref and other sources), both directions
    jobs.push(getJSON(API + '/events?doi=' + encodeURIComponent(bareDoi(doi)) + '&page[size]=500').then(function (j) {
      ((j && j.data) || []).forEach(function (ev) {
        var a = ev.attributes || {};
        var subj = a['subj-id'] || '', obj = a['obj-id'] || '';
        var rk = relKey(a['relation-type-id']);
        if (/orcid\.org/i.test(subj + obj) || /authored|funded/.test(rk)) return; // people and funders, not works
        if (bareDoi(subj).toLowerCase() === self) add(rk, obj, looksLikeDoi(obj) ? 'DOI' : 'URL');
        else if (bareDoi(obj).toLowerCase() === self) add(INVERSE[rk] || 'isrelatedto', subj, looksLikeDoi(subj) ? 'DOI' : 'URL');
      });
    }));

    // 5. the DataCite GraphQL graph
    jobs.push(fetch(API + '/graphql', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: query, variables: { id: doi } })
    }).then(function (r) { return r.json(); }).catch(function () { return null; }).then(function (res) {
      var work = res && res.data && res.data.work;
      REL.forEach(function (g) {
        var grp = work && work[g.key];
        ((grp && grp.nodes) || []).forEach(function (n) {
          var d = bareDoi(n.id);
          add(g.rel, d, 'DOI', {
            title: (n.titles && n.titles[0] && n.titles[0].title) || '',
            type: (n.types && n.types.resourceTypeGeneral) || '',
            href: 'https://commons.datacite.org/doi.org/' + d
          });
        });
      });
    }));
  }

  Promise.all(jobs).then(function () {
    // titles for DOIs we only know by number
    return Promise.all(items.filter(function (it) { return it.needsLookup; }).map(function (it) {
      return lookupDoi(it.id).then(function (info) {
        if (it.title === it.id) it.title = info.title;
        if (it.type === 'Other') it.type = info.type;
        if (/^https:\/\/doi\.org\//.test(it.href)) it.href = hrefFor('doi', it.id, it.id, info.datacite);
      });
    }));
  }).then(render).catch(function () { render(); });

  function render() {
    if (loading && loading.parentNode) loading.parentNode.removeChild(loading);
    if (!order.length) { showEmpty(); return; }
    var body = section.querySelector('.dc-connections-body');
    var allWorks = [], drawn = {};
    order.forEach(function (label) {
      var list = groups[label];
      var html = '<div class="dc-group"><p class="dc-group-head">' + esc(label) + '<span class="dc-count">' + list.length + '</span></p><ul>';
      list.forEach(function (it) {
        var c = colorFor(it.type);
        var badge = '<span class="dc-type-badge" style="background:' + c + '22;color:' + c + '">' + esc(it.type) + '</span>';
        var titleHtml = it.href
          ? '<a class="dc-rel-title" href="' + esc(it.href) + '" target="_blank" rel="noopener">' + badge + esc(it.title) + '</a>'
          : '<span class="dc-rel-title">' + badge + esc(it.title) + '</span>';
        var idText = it.isDoi ? it.id : (it.idType ? it.idType + ' ' : '') + it.id;
        html += '<li>' + titleHtml + '<span class="dc-rel-meta">' + esc(label) + ' · ' + esc(idText) + '</span></li>';
        if (!drawn[it.key]) { drawn[it.key] = true; allWorks.push({ doi: it.key, title: it.title, type: it.type, href: it.href }); }
      });
      html += '</ul></div>';
      body.insertAdjacentHTML('beforeend', html);
    });
    if (window.d3 && allWorks.length) drawGraph(allWorks);
  }
  function showEmpty() {
    if (graphWrap) graphWrap.style.display = 'none';
    var foot = section.querySelector('.dc-connections-foot');
    if (foot) foot.style.display = 'none';
    var intro = section.querySelector('.dc-connections-intro');
    if (intro) intro.style.display = 'none';
    if (empty) empty.style.display = '';
  }

  function drawGraph(works) {
    var svg = d3.select(section).select('.dc-graph');
    var W = 700, H = 440;
    var centerTitle = section.getAttribute('data-title') || 'This work';

    var nodes = [{ id: '__center__', label: truncate(centerTitle, 28), type: 'center', r: 30 }];
    var links = [];
    works.forEach(function (w) {
      nodes.push({ id: w.doi, label: truncate(w.title, 22), type: w.type, href: w.href, r: 22 });
      links.push({ source: '__center__', target: w.doi });
    });

    var link = svg.append('g').selectAll('line').data(links).enter().append('line');
    var node = svg.append('g').selectAll('g').data(nodes).enter().append('g')
      .attr('class', function (d) { return 'dc-node' + (d.type === 'center' ? ' dc-center' : ''); })
      .on('click', function (e, d) { if (d.href) window.open(d.href, '_blank', 'noopener'); });

    node.append('title').text(function (d) { return d.type === 'center' ? centerTitle : (d.type + ' — ' + d.label); });
    node.append('circle').attr('r', function (d) { return d.r; })
      .attr('fill', function (d) { return d.type === 'center' ? '#1b1b1a' : colorFor(d.type); });
    node.append('text').attr('text-anchor', 'middle').attr('dy', function (d) { return d.r + 14; })
      .attr('font-size', '11px').text(function (d) { return d.label; });

    var sim = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(links).id(function (d) { return d.id; }).distance(130))
      .force('charge', d3.forceManyBody().strength(-450))
      .force('center', d3.forceCenter(W / 2, H / 2))
      .force('collide', d3.forceCollide().radius(function (d) { return d.r + 22; }))
      .on('tick', function () {
        link.attr('x1', function (d) { return d.source.x; }).attr('y1', function (d) { return d.source.y; })
            .attr('x2', function (d) { return d.target.x; }).attr('y2', function (d) { return d.target.y; });
        node.attr('transform', function (d) {
          d.x = Math.max(d.r, Math.min(W - d.r, d.x));
          d.y = Math.max(d.r, Math.min(H - d.r - 12, d.y));
          return 'translate(' + d.x + ',' + d.y + ')';
        });
      });

    node.call(d3.drag()
      .on('start', function (e, d) { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
      .on('drag', function (e, d) { d.fx = e.x; d.fy = e.y; })
      .on('end', function (e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }));
  }
})();
</script>
{% endif %} 