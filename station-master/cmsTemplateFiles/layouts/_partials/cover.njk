{% set current = null %}
{% for i in issues.list %}{% if i.current and not current %}{% set current = i %}{% endif %}{% endfor %}
{% if not current %}{% set current = issues.list[0] %}{% endif %}

<section class="iplaces-cover">
  {% if current %}
  <div class="iplaces-cover-art">
    <a href="/issue/{{ current.slug }}/">
      <img src="{{ current.cover }}" alt="Current issue cover — {{ current.label }}" onerror="this.parentNode.parentNode.style.display='none'">
    </a>
  </div>
  {% endif %}
  <div class="iplaces-cover-text">
    <p class="iplaces-cover-eyebrow">{{ cmsConfig.group.name }}</p>
    <h1 class="iplaces-cover-title">{{ station.title | default("iPlaces") }}</h1>
    <p class="iplaces-cover-mission">{{ station.mission | default("") }}</p>
   {# {% if current %}<p class="iplaces-cover-issue">{{ current.label }}</p>{% endif %} #}
    <p class="iplaces-cover-actions">
      {% if current %}<a class="iplaces-cover-primary" href="/issue/{{ current.slug }}/">View current issue &rarr;</a>{% endif %}
    </p>
    <p class="iplaces-cover-links">
      <a href="/archive/">All issues</a>
      <a href="/browse/">Browse by author &amp; institution</a>
      <a href="/collections/">Collections</a>
    </p>
  </div>
</section>

{% if station.otc %}
<section class="otc-notice">
  <div class="otc-inner">
    <img class="otc-icon" src="{{ station.otc.icon | default("") }}" alt="Local Contexts — Open to Collaborate Notice">
    <div class="otc-text">
      <h2 class="otc-title">{{ station.otc.title | default("Open to Collaborate") }}</h2>
      <p class="otc-body">{{ station.otc.body | default("") }}</p>
      <p class="otc-link"><a href="{{ station.otc.linkUrl | default("#") }}" target="_blank" rel="noopener">{{ station.otc.linkText | default("") }}</a></p>
    </div>
  </div>
</section>
{% endif %}

<style>
  .iplaces-cover {
    max-width: 900px; margin: 0 auto 2.5rem; padding: 2.5rem 1.5rem 2rem;
    display: flex; gap: 2.5rem; align-items: center;
    border-bottom: 2px solid #1b1b1a;
  }
  .iplaces-cover-art { flex-shrink: 0; }
  .iplaces-cover-art img {
    width: 215px; height: 283px; object-fit: cover; display: block;
    border: 1px solid #d6d3d1; box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .iplaces-cover-text { flex: 1; }
  .iplaces-cover-eyebrow {
    font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: #78716c; margin: 0 0 0.5rem;
  }
  .iplaces-cover-title {
    font-family: Georgia, "Times New Roman", serif; font-size: 2.4rem; font-weight: 600;
    line-height: 1.05; margin: 0 0 0.75rem; color: #1b1b1a;
  }
  .iplaces-cover-mission { font-size: 0.95rem; color: #57534e; line-height: 1.6; margin: 0 0 1.25rem; max-width: 46ch; }
  .iplaces-cover-issue { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: #1c1917; margin: 0 0 0.75rem; }
  .iplaces-cover-actions { margin: 0 0 1rem; }
  .iplaces-cover-primary {
    display: inline-block; font-size: 0.95rem; font-weight: 600;
    color: #fff; background: #1b1b1a; text-decoration: none;
    padding: 0.5rem 1.1rem; border-radius: 4px;
  }
  .iplaces-cover-primary:hover { background: #185fa5; }
  .iplaces-cover-links a { font-size: 0.85rem; color: #185fa5; text-decoration: none; margin-right: 1.25rem; }
  .iplaces-cover-links a:hover { text-decoration: underline; }

  .otc-notice { max-width: 900px; margin: 0 auto 2.5rem; padding: 1.5rem; background: #f5f5f4; border: 1px solid #e0ddd4; border-left: 4px solid #1b1b1a; border-radius: 4px; }
  .otc-inner { display: flex; gap: 1.25rem; align-items: flex-start; max-width: 820px; }
  .otc-icon { flex-shrink: 0; width: 88px; height: auto; display: block; }
  .otc-text { flex: 1; }
  .otc-title { font-family: Georgia, "Times New Roman", serif; font-size: 1.15rem; font-weight: 600; margin: 0 0 0.5rem; color: #1b1b1a; letter-spacing: 0.01em; }
  .otc-body { font-size: 0.9rem; color: #57534e; line-height: 1.6; margin: 0 0 0.75rem; }
  .otc-link a { font-size: 0.82rem; color: #185fa5; text-decoration: none; }
  .otc-link a:hover { text-decoration: underline; }

  @media (max-width: 700px) {
    .iplaces-cover { flex-direction: column; gap: 1.5rem; align-items: flex-start; padding: 1.5rem 1.1rem; }
    .iplaces-cover-art img { width: 160px; height: 211px; }
    .iplaces-cover-title { font-size: 2rem; }
    .otc-notice { padding: 1.1rem; }
    .otc-inner { flex-direction: column; gap: 0.85rem; }
    .otc-icon { width: 72px; }
  }
</style>