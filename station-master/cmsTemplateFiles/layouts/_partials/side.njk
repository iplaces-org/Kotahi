<style>
/* ---- Sidebar readability pass (scoped to .side-section) ---- */

/* Reset the blanket bold: everything normal weight by default */
aside.side-section,
aside.side-section p,
aside.side-section dd,
aside.side-section li,
aside.side-section span {
  font-weight: 400 !important;
  color: #1b1b1a;
}

/* Section headings (dt): keep as anchors, but calmer — small caps style */
aside.side-section dt.review-timeline__event {
  font-weight: 700 !important;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #57574f;
  margin-bottom: 0.5rem;
}

/* Curated intro line at top of About: quieter */
aside.side-section .about-this__intro {
  font-size: 0.9rem;
  color: #57574f;
  line-height: 1.45;
  margin: 0 0 0.9rem;
}

/* Links: colored, never bold, underline on hover only */
aside.side-section a:not(.button) {
  font-weight: 400 !important;
  color: var(--color-primary, #087cca);
  text-decoration: none;
}
aside.side-section a:not(.button):hover {
  text-decoration: underline;
}

/* About-this rows: label above value, label gray uppercase, value dark normal */
aside.side-section .about-this__row {
  margin: 0 0 0.7rem;
}
aside.side-section .about-this__label {
  display: block;
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #7a7a72;
  margin-bottom: 0.1rem;
}
aside.side-section .about-this__value {
  display: block;
  font-size: 0.9rem;
  line-height: 1.4;
}

/* DOI: muted, and long-string safe (the page-width lesson) */
aside.side-section .about-this__doi a {
  color: #8a8a82;
  overflow-wrap: anywhere;
  word-break: break-word;
  font-size: 0.85rem;
}

/* Button row inside About (Download / Cite / Share) */
aside.side-section .about-this__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 0.6rem;
}

/* Related works: compressed list, no separators */
aside.side-section .related-works {
  list-style: none;
  margin: 0;
  padding: 0;
}
aside.side-section .related-works__item {
  padding: 0.22rem 0;
  font-size: 0.88rem;
  line-height: 1.35;
}
aside.side-section .related-works__more {
  margin-top: 0.7rem;
}

/* Section separators: lighter than default hr */
aside.side-section hr {
  border: 0;
  border-top: 1px solid #e9e7df;
  margin: 1.25rem 0;
}

/* Buttons: pinned white style, independent of theme container scoping */
aside.side-section .button {
  font-weight: 600 !important;
  background: #ffffff !important;
  border: 1px solid #d9d6cd !important;
  border-radius: 6px !important;
  color: #1d3f6e !important;
  padding: 0.45rem 0.9rem !important;
  text-decoration: none !important;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  line-height: 1.2;
}
aside.side-section .button:hover {
  background: #f5f4f0 !important;
}
</style>

{# ---- Gate: normalize accessLevel (tolerates string / {label,value} object / absent) ---- #}
{% set alRaw = article.parsedSubmission.accessLevel %}
{% set alVal = alRaw.value | default(alRaw) %}
{% set al = (alVal | default("")) | string | lower | trim %}
{% set isGated = (al != "") and (al != "public") %}

{# ---- ROR badge macro (bare id -> DataCite Commons, jsDelivr icon, size pinned inline) ---- #}
{% macro rorBadge(rorUrl) %}
  {% set rorId = (rorUrl | string) | replace("https://ror.org/", "") | replace("http://ror.org/", "") | trim %}
  {% if rorId %}
    <a class="ror-badge" href="https://commons.datacite.org/ror.org/{{ rorId }}" target="_blank" rel="noopener noreferrer"><img src="https://cdn.jsdelivr.net/gh/ror-community/ror-logos@main/ror-icon-rgb.svg" alt="ROR" class="ror-badge__icon" style="height: 0.95em; width: auto; vertical-align: -0.1em; margin-left: 0.25em; display: inline;" /></a>
  {% endif %}
{% endmacro %}

<aside class="side-section">
  <div class="article-status">
    <div class="article-actions-container">

      {# ---- About this [type]: curated intro, Published, Funding, Coverage, DOI, action buttons ----
           Stays OUTSIDE the gate: this metadata IS the tombstone. Heading set
           client-side from DataCite types.resourceTypeGeneral. #}
      <div class="review-timeline-container about-this-container">
        <dl class="review-timeline" aria-label="About this article">
          <dt class="review-timeline__event review-timeline__event--revised" id="about-this-heading">About this article</dt>
          <dd class="review-timeline__detail review-timeline__event--revised">
            <div class="about-this">
              <p class="about-this__intro">{{ station.shortName | default(station.title) }} has curated this project application. <a href="{{ station.hostOrg.url | default("#") }}">About {{ station.shortName | default(station.title) }}’s process</a></p>

              {% if article.headerInfo.publishedOn %}
              <div class="about-this__row">
                <span class="about-this__label">Published</span>
                <span class="about-this__value">{{ (article.headerInfo.publishedOn | string).split('T')[0] }}</span>
              </div>
              {% endif %}

              {% set frefs = article.parsedSubmission.fundingReferences | default([]) %}
              {% if frefs.length > 0 %}
              <div class="about-this__row">
                <span class="about-this__label">Funding</span>
                {% for f in frefs %}
                <span class="about-this__value about-this__funding">
                  {{ f.funder.label | default(f.funder.value) | default(f.funder) | default("") }}
                  {% if f.funder.value and ("ror.org" in (f.funder.value | string)) %}{{ rorBadge(f.funder.value) }}{% endif %}
                  {% if f.awardTitle %}<span class="about-this__award-title">{{ f.awardTitle }}</span>{% endif %}
                  {% if f.awardNumber %}
                    {% if f.awardUri %}<a href="{{ f.awardUri }}" target="_blank" rel="noopener noreferrer">Award {{ f.awardNumber }}</a>{% else %}<span>Award {{ f.awardNumber }}</span>{% endif %}
                  {% endif %}
                </span>
                {% endfor %}
              </div>
              {% endif %}

              {% if article.parsedSubmission.geolocation %}
              <div class="about-this__row">
                <span class="about-this__label">Coverage</span>
                <span class="about-this__value">{{ article.parsedSubmission.geolocation }}</span>
              </div>
              {% endif %}

              {% if article.parsedSubmission.$doi %}
              <div class="about-this__row">
                <span class="about-this__label">DOI</span>
                <span class="about-this__value about-this__doi"><a href="https://doi.org/{{ article.parsedSubmission.$doi }}" target="_blank" rel="noopener noreferrer">{{ article.parsedSubmission.$doi }}</a></span>
              </div>
              {% endif %}

              <div class="about-this__buttons">
                {% if not isGated %}
                <a class="button button--icon-download button--action" id="download-button" rel="nofollow"
                   href="https://iplaces-pdf.fly.dev/pdf/{{ cmsConfig.group.name }}/{{ article.shortId }}"
                   target="_blank">Download</a>
                {% endif %}
                <a class="button button--icon-citation button--action" id="cite-button" rel="nofollow">Cite</a>
                <a class="button button--icon-share button--action" id="share-button" rel="nofollow">Share</a>
              </div>
            </div>
          </dd>
        </dl>
      </div>

      {# ---- Local Contexts (stays OUTSIDE the gate: rights info is tombstone-visible) ---- #}
      {% set lc =
        (article.articleMetadata and article.articleMetadata.submission and article.articleMetadata.submission.$localContext)
        or (article.parsedSubmission and article.parsedSubmission.$localContext)
      %}

            {% if lc and lc.url and (lc.label or lc.notice) %}
        <hr />
        <div class="review-timeline-container local-context-container">
          <dl class="review-timeline" aria-label="Local Contexts">
            <dt class="review-timeline__event review-timeline__event--revised">Local Contexts</dt>
            <dd class="review-timeline__detail review-timeline__event--revised">
              {% if lc.label %}
                <div class="local-context-labels">
                  {% for label in lc.label %}
                    <a href="{{ lc.url }}" target="_blank" rel="noopener noreferrer" title="{{ label.labelText }}">
                      <img src="{{ label.imgUrl }}" alt="{{ label.name }}" class="local-context-label" />
                    </a>
                  {% endfor %}
                </div>
              {% endif %}

              {% if lc.notice %}
                <div class="local-context-notices">
                  {% for notice in lc.notice %}
                    <a href="{{ lc.url }}" target="_blank" rel="noopener noreferrer" title="{{ notice.defaultText }}">
                      <img src="{{ notice.imgUrl }}" alt="{{ notice.name }}" class="local-context-notice" />
                    </a>
                  {% endfor %}
                </div>
              {% endif %}

              {% if station.otc %}<p class="local-context__about"><a href="{{ station.baseUrl | default("") }}/{{ cmsConfig.group.name }}/local-contexts/index.html">About Local Contexts at {{ station.shortName | default(station.title) }}</a></p>{% endif %}
            </dd>
          </dl>
        </div>
      {% endif %}

      {% if not isGated %}
      {# ---- Add supplementary files (gated: file actions are member-only on restricted items) ---- #}
      <hr />
      <div class="review-timeline-container">
        <dl class="review-timeline" aria-label="Add supplementary files">
          <dt class="review-timeline__event review-timeline__event--revised">Add supplementary files</dt>
          <dd class="review-timeline__detail review-timeline__event--revised">
            <a class="button button--action" id="zenodo-button" rel="nofollow"
               target="_blank" rel="noopener noreferrer"
               href="https://iplaces-zenodo.fly.dev/zenodo/start?shortId={{ article.shortId }}&group={{ cmsConfig.group.name }}">
              Add files to Zenodo
            </a>
          </dd>
        </dl>
      </div>
      {% endif %}

      {# ---- Related works: merge inbound + outbound DataCite relations, resolve real titles ---- #}
      <hr />
      <div class="review-timeline-container">
        <dl class="review-timeline" aria-label="Related works">
          <dt class="review-timeline__event review-timeline__event--revised">Related works</dt>
          <dd class="review-timeline__detail review-timeline__event--revised">
            <ul class="related-works" id="related-works"><li>Loading…</li></ul>
            {% if article.parsedSubmission.$doi %}
            <div class="related-works__more">
              <a class="button button--action" href="https://commons.datacite.org/doi.org/{{ article.parsedSubmission.$doi }}" target="_blank" rel="noopener noreferrer">DataCite Commons</a>
            </div>
            {% endif %}
          </dd>
        </dl>
      </div>

      <script>
      (function () {
        var doi = "{{ article.parsedSubmission.$doi }}";
        var el  = document.getElementById("related-works");
        if (!doi || !el) return;

        var API = "https://api.datacite.org";

        function bare(s) {
          s = String(s || "").toLowerCase();
          var i = s.indexOf("doi.org/");
          return i >= 0 ? s.slice(i + 8) : s;
        }
        var self = bare(doi);

        var RELATION_LABELS = {
          issupplementto: "Supplementary material",
          issupplementedby: "Supplemented by",
          references: "Referenced work",
          isreferencedby: "Referenced by",
          cites: "Cited work",
          iscitedby: "Cited by",
          ispartof: "Part of",
          haspart: "Has part",
          isversionof: "Version of",
          isderivedfrom: "Derived from"
        };
        function relationLabel(rel) {
          return RELATION_LABELS[(rel || "").toLowerCase()] || (rel || "Related");
        }

        function getJSON(u) {
          return fetch(u, { headers: { Accept: "application/vnd.api+json" } })
            .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
            .catch(function (e) { console.error("DataCite fetch failed:", u, e); return null; });
        }

        function resolveTitle(id) {
          return getJSON(API + "/dois/" + encodeURIComponent(id)).then(function (j) {
            var a = (j && j.data && j.data.attributes) || {};
            return (a.titles && a.titles[0] && a.titles[0].title) || id;
          });
        }

        var inboundUrl = API + "/dois?query=" +
          encodeURIComponent('relatedIdentifiers.relatedIdentifier:"' + doi + '"') +
          "&sort=-created&page[size]=10";
        var selfUrl = API + "/dois/" + encodeURIComponent(doi);

        Promise.all([getJSON(inboundUrl), getJSON(selfUrl)]).then(function (res) {
          var inbound = res[0], outbound = res[1];
          var seen = {}, rows = [];

          var outAttr = (outbound && outbound.data && outbound.data.attributes) || {};

          // dynamic "About this [type]" heading from the MINTED DataCite type
          var heading = document.getElementById("about-this-heading");
          if (heading) {
            var rtg = ((outAttr.types || {}).resourceTypeGeneral || "");
            var TYPE_LABELS = {
              journalarticle: "article",
              text: "article",
              project: "project",
              dataset: "dataset",
              conferencepaper: "conference paper",
              conferenceproceeding: "conference proceeding",
              event: "event",
              report: "report",
              audiovisual: "recording"
            };
            var label = TYPE_LABELS[rtg.toLowerCase()] || "article";
            heading.textContent = "About this " + label;
          }

          // inbound: full records, already have titles + dates, newest first
          var inItems = (inbound && inbound.data) || [];
          inItems.forEach(function (d) {
            var a = d.attributes || {};
            var id = bare(a.doi || d.id);
            if (!id || id === self || seen[id]) return;
            seen[id] = 1;
            rows.push({
              ready: true,
              title: (a.titles && a.titles[0] && a.titles[0].title) || a.doi || d.id,
              href: "https://doi.org/" + (a.doi || d.id)
            });
          });

          // outbound: identifier + relation only; resolve DOI titles, label ARKs
          (outAttr.relatedIdentifiers || []).forEach(function (ri) {
            var rawId = ri.relatedIdentifier || "";
            var id = bare(rawId);
            if (!id || id === self || seen[id]) return;
            seen[id] = 1;
            var isDoi = (ri.relatedIdentifierType || "").toLowerCase() === "doi";
            rows.push({
              ready: false,
              isDoi: isDoi,
              id: id,
              rawId: rawId,
              relation: ri.relationType || "",
              href: isDoi ? "https://doi.org/" + id : rawId
            });
          });

          if (!rows.length) { el.innerHTML = "<li>No related works yet.</li>"; return; }

          var shown = rows.slice(0, 5);

          var jobs = shown.map(function (row) {
            if (row.ready) return Promise.resolve({ title: row.title, href: row.href });
            if (row.isDoi) {
              return resolveTitle(row.id).then(function (t) {
                return { title: t, href: row.href };
              });
            }
            return Promise.resolve({
              title: relationLabel(row.relation) + ": " + row.rawId,
              href: row.href
            });
          });

          Promise.all(jobs).then(function (out) {
            el.innerHTML = "";
            out.forEach(function (row) {
              var li = document.createElement("li");
              li.className = "related-works__item";
              var link = document.createElement("a");
              link.href = row.href;
              link.target = "_blank";
              link.rel = "noopener noreferrer";
              link.textContent = row.title;
              li.appendChild(link);
              el.appendChild(li);
            });
          });
        });
      })();
      </script>
    </div>
  </div>
</aside>

<div id="citeModal" class="modal modal--cite">
  <!-- Modal content -->
  <div class="modal-content modal-content--cite">
    <div class="modal-content__top">
      <h5 class="modal-content__title">Cite this article</h5>
      <span id="closeCiteModal" class="close modal-content__close-button">&times;</span>
    </div>
    <div class="modal-content__body">
      <div id="citedArea">
        {% set authors = article.headerInfo.authorNames %}
        {% for author in authors %}
          {{- author.lastName -}}, {{ author.firstName[0] }}.{% if author.middleName and author.middleName.length > 0 %} {{ author.middleName[0] }}.{% endif %}
          {% if not loop.last %}{% if loop.index == loop.length - 1 %}, & {% else %}, {% endif %}{% endif %}
        {% endfor %}
        {% set pubYear = article.headerInfo.publishedOn.split('-')[0] %}
        ({{ pubYear }}).
        <span style="font-style: italic;">{{ article.parsedSubmission.$title or 'Untitled' }}</span>.
        {{ station.title | default("iPlaces") }}. https://doi.org/{{ article.parsedSubmission.$doi or 'N/A' }}
      </div>

      <ol class="cite-downloads__list">
        <li class="cite-downloads__list-item">
          <button id="cite-copy-btn" class="button button--clipboard" onclick="copyToClipboard()">Copy to clipboard</button>
          <p id="cite-copy-status" style="display: none; font-size: 0.85rem; color: green; margin-top: 0.5rem;">
            ✅ Copied!
          </p>
        </li>
      </ol>
    </div>
  </div>
</div>


<div id="shareModal" class="modal" style="align-items: center;justify-content: center;background: #0470c022;z-index: 9999;backdrop-filter: blur(4px);">
  <!-- Modal content -->
  <div class="modal-content">
    <div class="modal-content__top">
    <h5 class="modal-content__title">Share this article</h5>
    <span id="closeShareModal" class="close modal-content__close-button">&times;</span>
    </div>
    <div class="modal-content__body">
    <div class="form-item">
      <input readonly="" type="input" class="text-field text-field--clipboard" id="copydoi" value="https://doi.org/{{ article.parsedSubmission.$doi }}">
      <div class="clipboard-container">
        <button class="button button--clipboard" onclick="copyToClipboardDoi()">Copy to clipboard</button>
        <p id="share-copy-status" style="display: none; font-size: 0.85rem; color: green; margin-top: 0.5rem;">
            ✅ Copied!
          </p>
      </div>
    </div>
    </div>
  </div>
</div>

<script>
// Get the modal
var closeCiteModal = document.getElementById('closeCiteModal');
var closeShareModal = document.getElementById('closeShareModal');
var citeModal = document.getElementById("citeModal");
var shareModal = document.getElementById("shareModal");

// Get the button that opens the modal
var citeBtn = document.getElementById("cite-button");
var shareBtn = document.getElementById("share-button");

// Get the <span> element that closes the modal
var span = document.getElementsByClassName("close")[0];

// When the user clicks on the button, open the modal
citeBtn.onclick = function() {
  citeModal.style.display = "flex";
}

shareBtn.onclick = function() {
  shareModal.style.display = "flex";
}

// When the user clicks on <span> (x), close the modal
closeCiteModal.onclick = function() {
  citeModal.style.display = "none";
}

closeShareModal.onclick = function() {
  shareModal.style.display = "none";
}

function copyToClipboard() {
  const div = document.getElementById("citedArea");

  // Create a temporary textarea element
  const tempTextArea = document.createElement("textarea");
  tempTextArea.value = div.innerText || div.textContent; // Get the div content

  // Append it to the body
  document.body.appendChild(tempTextArea);

  // Select the content
  tempTextArea.select();
  tempTextArea.setSelectionRange(0, 99999); // For mobile devices

  // Copy the content to clipboard
  document.execCommand("copy");

  // Remove the temporary textarea
  document.body.removeChild(tempTextArea);

    // Show confirmation message
  const status = document.getElementById("cite-copy-status");
  status.style.display = "block";

  // Hide after 2 seconds
  setTimeout(() => {
    status.style.display = "none";
  }, 2000);
}

function copyToClipboardDoi () {
  const div = document.getElementById("copydoi");

  // Create a temporary textarea element
  const tempTextArea = document.createElement("textarea");
  tempTextArea.value = div.innerText || div.textContent || div.value; // Get the div content

  // Append it to the body
  document.body.appendChild(tempTextArea);

  // Select the content
  tempTextArea.select();
  tempTextArea.setSelectionRange(0, 99999); // For mobile devices

  // Copy the content to clipboard
  document.execCommand("copy");

  // Remove the temporary textarea
  document.body.removeChild(tempTextArea);

  // Show confirmation message
  const status = document.getElementById("share-copy-status");
  status.style.display = "block";

  // Hide after 2 seconds
  setTimeout(() => {
    status.style.display = "none";
  }, 2000);
}

</script>