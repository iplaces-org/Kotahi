<style>

  footer#main-footer {
    --gradient-height: 10px;

    align-items: center;
    width: 100%;
    flex-direction: column;
    display: flex;
    background: linear-gradient(120deg, #f0f5fb 48%, #fcfdfe 48%);
    justify-content: center;
    position: relative;
    padding-top: var(--gradient-height);
    z-index: 9999;
    margin-bottom: 0;
    padding-bottom: 0;
    margin-top: auto;

    .footer-container {
      display: flex;
      flex-direction: column;
      align-items: center;         /* centre the footer stack on desktop */
      padding: 30px 24px;          /* 24px side gutter — matches content */
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;              /* centre it, same as #main-container */
      box-sizing: border-box;

      .footer-container--top {
        display: flex;
        justify-content: center;   /* centred, was space-between */
        align-items: center;
        text-align: center;
        width: 100%;
        padding: 0 0 20px 0;       /* container owns the side gutter now */

        h5, p, a {
            color: #0470c0;
            margin: 5px;
            padding: 0;
          }

          a {
            text-decoration: underline;
          }

          a.cc-license {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            text-decoration: underline;
            white-space: nowrap;
          }
          a.cc-license .cc-icons {
            display: inline-flex;
            gap: 3px;
          }
          a.cc-license .cc-icons svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
            vertical-align: middle;
          }
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        margin-top: 0px;
        border-bottom: 1px solid #0470c024;
        padding: 8px 0;            /* side gutter comes from .footer-container */
      }
    }

    @media (max-width: 1100px) {
      padding-top: 16px;
      .footer-container {
        align-items: center;       /* centered when folded */
        padding-inline: 24px;

        .footer-container--top {
          flex-direction: column;
          align-items: center;
          gap: 4px;
          padding: 0;

          img {
            width: 95%;
            z-index: 99;
          }
        }

        .footer-bottom {
          margin-top: 12px;        /* tighter than the original 30px */
          flex-wrap: wrap;
          justify-content: center;
        }
      }
    }
  }

  .iplaces-link {
    color: #0470c0;
    padding: 0;
    width: fit-content;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    cursor: pointer;
    margin-top: 25px;

    &::before {
      content: 'Powered by:';
      font-size: 10px;
      color: currentColor;
    }

    svg {
      width: 110px;
      height: auto;
      fill: currentColor;
    }
  }

  .logo img {
    max-width: 75%;
  }

  /* #region media queries */
  @media (max-width: 1100px) {
    .dektop-only {
      display: none !important;
    }
  }
  /* #endregion media queries */
</style>

