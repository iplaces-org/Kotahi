<style>
  #sticky-menu {
    background: #fff;
    align-items: center;
    position: sticky;
    top: 0;
    padding: 0 20px;
    display: flex;
    width: 100%;
    justify-content: space-between;
    z-index: 999999;
    max-width: 1400px;
  }
  nav {
    align-items: center;
    height: 100px;
    display: flex;
    overflow-x: hidden;
    overflow-y: visible;
    height: 100%;

    * {
      user-select: none;
    }
    a,
    .link > label {
      display: flex;
      align-items: center;
      color: black;
      font-size: 18px;
      font-weight: 500;
      margin-left: 30px;
      height: 100%;
      transition: all 0.3s;
      text-decoration: none;
      white-space: nowrap;
      position: relative;
      cursor: pointer;

      &::before {
        background-color: #0470c0;
        content: '';
        display: block;
        height: 2px;
        margin-top: 5px;
        width: 100%;
        bottom: 50%;
        position: absolute;
        opacity: 0;
        transition: all 0.3s;
      }

      &:hover {
        color: #0470c0;
        &::before,
        &:focus::before {
          opacity: 1;
          bottom: 0;
        }
      }
    }
    .dropdown-btn {
      display: none;
    }

    .dropdown {
      display: flex;
      top: 100px;
      border: 1px solid #ddd0;
      border-block: none;
      height: fit-content;
      flex-direction: column;
      background: #fff;
      position: absolute;
      max-height: 0;
      overflow: hidden;
      transition: all 0.3s;
      padding: 0;
      z-index: 5;

      * {
        transition: all 0.3s, color 0s;
        opacity: 0;
      }
      a {
        color: #0470c0;
        font-size: 14px;
        border-bottom: 1px solid #ddd9;
        margin: 0;
        padding: 10px 20px;
        &::before {
          display: none;
        }
        &:hover {
          background: #0470c0;
          color: #fff;
        }
      }
    }
    .link {
      height: 100%;
      display: flex;
      justify-content: flex-end;
      overflow: visible;
      position: static;
      input:checked ~ .dropdown {
        max-height: 300px;
        border-color: #ddd5;
        z-index: 10;

        * {
          opacity: 1;
        }
      }
      input:checked ~ label.open-dropdown {
        color: #0470c0 !important;
        &::before,
        &:focus::before {
          opacity: 1 !important;
          bottom: 0;
        }
      }

      > label svg.collapse-icon {
        width: 20px;
        height: 20px;
        transform: scaleY(-1);
        fill: #0470bf;
        margin-left: 20px;
      }
    }

    @media (max-width: 768px) {
      border-left: 1px solid #ddd;
      position: absolute;
      background-color: #fff;
      right: 0;
      top: var(--header-height);
      z-index: 30;
      padding: 25px 0;
      max-width: 0;
      height: 100dvh;
      background: #fff !important;

      display: block;
      top: 60px;
      width: 100dvw !important;
      transition: all 0.3s !important;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      .link,
      a {
        width: 100%;
        height: fit-content !important;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .dropdown {
        position: relative !important;
        top: 0;
        left: 0;
        transform: none;
        max-height: 100%;
        margin-bottom: 10px;

        a {
          color: #222;
          align-items: center;
          opacity: 1;
          border: none;
        }
      }

      * {
        opacity: 0;
      }

      > :first-child {
        padding-top: 10px;
      }

      a,
      .link > label {
        margin: 0;
        padding: 0 20px 10px;
        height: 100%;
        text-align: center;

        &::before {
          display: none;
        }
      }
      label.open-dropdown > span {
        color: #0470c0;
      }
    }
  }

  nav.toc a {
    &::before {
      display: none;
    }
  }

  #topbar {
    display: flex;
    width: 100%;
    justify-content: flex-end;
    padding: 10px 20px;
    /* iPlaces: header strip uses the station's theme colour (CMS > Layout) */
    background: {{ cmsLayout.primaryColor or '#0470c0' }};
    color: #fff;
    transition: all 0.3s;
    height: 34px;
    max-height: 50px;
    &.hide-topbar {
      padding: 0 20px;
      max-height: 0;
    }
  }
  #menu {
    transition: all 0.3s;
  }
  /* Responsive Styles */
  @media screen and (max-width: 768px) {
    #main-container {
      flex-direction: column;
      width: 100% !important;
    }

    main {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .article-preview main {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 0;
    }

    .tabs {
      top: 58px;
    }

    aside {
      width: 100%;
      position: relative;
      top: unset;
      right: unset;
    }

    aside.toc-wrapper {
      display: none;
            width: 15dvw;
    }

    #sticky-menu {
      height: 60px;
      background: {{ cmsLayout.primaryColor or '#0470c0' }} !important;
      padding-left: 0 !important;
    }

    .article-preview .article-content {
      flex-direction: column;
    }

    .fullwidth-box {
      padding: 0px;
    }
  }
  /*menu btn*/

  input#menu-btn {
    display: none;
  }

  .menu-icon {
    cursor: pointer;
    display: flex;
    height: 24px;
    padding: 16px;
    width: 24px;
    transform: scale(1.2);
  }

  label.menu-icon {
    position: relative;
    z-index: 200;
    display: none;

    margin-bottom: 5px;
    @media screen and (max-width: 768px) {
      display: flex;
    }
  }

  .menu-icon .menu,
  .menu-icon .menu::before,
  .menu-icon .menu::after {
    background: #fff;
    content: '';
    display: block;
    height: 2px;
    position: absolute;
    transition: background ease 0.2s, top ease 0.2s 0.2s, transform ease 0.2s;
    width: 20px;
  }

  .menu-icon:hover .menu,
  .menu-icon:hover .menu::before,
  .menu-icon:hover .menu::after {
    background: #fff;
  }

  .menu-icon .menu {
    left: 6px;
    top: 16px;
  }

  .menu-icon .menu::before {
    top: -6px;
  }

  .menu-icon .menu::after {
    top: 6px;
  }

  #menu-btn:checked + .menu-icon .menu {
    background: transparent;
  }

  #menu-btn:checked + .menu-icon .menu::before {
    transform: rotate(45deg);
  }

  #menu-btn:checked + .menu-icon .menu::after {
    transform: rotate(-45deg);
  }

  #menu-btn:checked + .menu-icon .menu::before,
  #menu-btn:checked + .menu-icon .menu::after {
    top: 0;
    transition: top ease 0.2s, transform ease 0.2s 0.2s;
  }

  #menu-btn:checked ~ nav {
    max-width: 100%;
    padding-inline: 25px;

    * {
      opacity: 1;
    }
  }

  /* a11y: on small screens the menu toggle must stay keyboard-reachable
     (visually hidden, not display:none), and closed-menu links must not
     take focus while invisible. */
  @media screen and (max-width: 768px) {
    input#menu-btn {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      opacity: 0;
      pointer-events: none;
    }
    #menu-btn:focus-visible + label.menu-icon {
      outline: 3px solid #fff;
      outline-offset: 2px;
    }
    #menu-btn:not(:checked) ~ nav#menu {
      visibility: hidden;
    }
  }

  .mobile-only {
    display: none;
    @media screen and (max-width: 768px) {
      display: flex !important;
    }
  }

  .desktop-only {
    display: flex;
    @media screen and (max-width: 768px) {
      display: none !important;
    }
  }

.manuscript a {
  border-bottom: 1px dotted;
}

.logo img{
  max-width: 75%;
}

/* ---- iPlaces: cleaner header, closer to the Alliance home page -------- *
   A thin accent line in the station colour replaces the tall empty strip,
   the menu bar gets a hairline instead of a heavy band, and the menu links
   are smaller and quieter, underlining in the station colour on hover. */
#topbar {
  height: 5px;
  max-height: 5px;
  padding: 0 !important;
}
#sticky-menu {
  min-height: 76px;
  border-bottom: 1px solid #e3e2da;
}
#sticky-menu nav a,
#sticky-menu nav .link > label {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: #2b2d27;
}
#sticky-menu nav a::before {
  background-color: {{ cmsLayout.primaryColor or '#0470c0' }};
}
#sticky-menu nav a:hover {
  color: {{ cmsLayout.primaryColor or '#0470c0' }};
}
/* Header logo: capped here as well as in theme/custom.njk, so the cap
   applies wherever this partial is used. */
#sticky-menu { padding-left: 24px; padding-right: 24px; box-sizing: border-box; }
#sticky-menu .logo { flex-shrink: 0; padding: 12px 0; }
#sticky-menu .logo img {
  display: block; height: auto; width: auto;
  max-height: 72px; max-width: 280px; object-fit: contain;
}
/* Journal title next to the logo, in the Alliance heading style */
.iplaces-masthead { display: flex; align-items: flex-end; gap: 18px; min-width: 0; padding: 12px 0; }
#sticky-menu .iplaces-masthead .logo { padding: 0; }
.iplaces-masthead .logo, .iplaces-masthead .logo a, .iplaces-masthead .logo img { display: block; }
.iplaces-masthead-title {
  font-weight: 700; font-size: 28px; line-height: 1; letter-spacing: -0.02em; margin-bottom: -0.1em;
  color: #22251c; text-decoration: none; white-space: nowrap;
}
.iplaces-masthead-title:hover { background: none; }
@media screen and (max-width: 1100px) {
  .iplaces-masthead-title { font-size: 22px; white-space: normal; }
}
/* Mobile: same white bar as desktop (logo files are made for a light
   background), logo inset from the edge and sized to the bar, dark menu icon. */
@media screen and (max-width: 768px) {
  #sticky-menu {
    background: #fff !important;
    height: auto !important;
    min-height: 64px;
    padding: 8px 16px !important;
    box-sizing: border-box;
  }
  #sticky-menu .logo { padding: 0; }
  #sticky-menu .logo img {
    max-height: 48px !important;
    max-width: 200px !important;
    width: auto !important;
  }
  .iplaces-masthead { gap: 10px; padding: 0; }
  .iplaces-masthead-title { font-size: 17px; }
  .menu-icon .menu,
  .menu-icon .menu::before,
  .menu-icon .menu::after,
  .menu-icon:hover .menu,
  .menu-icon:hover .menu::before,
  .menu-icon:hover .menu::after {
    background: #22251c;
  }
}
</style>


<div
  id="topbar"
>
</div>
{% if station.trial %}
<div class="iplaces-trial-banner" style="width:100%;background:#b45309;color:#ffffff;text-align:center;padding:8px 16px;box-sizing:border-box;font-size:14px;line-height:1.4;font-family:inherit;">
  {{ station.trial }}
</div>
{% endif %}
<div id="sticky-menu" role="banner">
<div class="iplaces-masthead">
{% include "_partials/logo.njk" %}
{% set mastTitle = station.title or cmsLayout.publishConfig.title or cmsConfig.group.name %}
<a class="iplaces-masthead-title" href="/{% if cmsLayout.hexCode %}{{cmsLayout.hexCode}}/{% endif %}">{{ mastTitle }}</a>
</div>
  <input type="checkbox" id="menu-btn" aria-label="Menu" aria-controls="menu" /><label
    for="menu-btn"
    class="menu-icon"
    aria-hidden="true"
  >
    <div class="menu"></div>
  </label>
  <nav id="menu" aria-label="Main">
    <a href="/browse" {% if page.url == '/browse/' %}aria-current="page"{% endif %}>
      <span>Browse</span>
    </a>
    <a href="/archive/" {% if page.url == '/archive/' %}aria-current="page"{% endif %}>
      <span>Archive</span>
    </a>
    <a href="/collections/" {% if page.url == '/collections/' %}aria-current="page"{% endif %}>
      <span>Collections</span>
    </a>
{# Shown only when the station has a CMS page at /editorial-policy/ (same check as footer.njk). #}
{% set edPolicyMenu = [] %}{% for p in (cmsPages.pages or []) %}{% if p.url == "/editorial-policy/" %}{% set _ = edPolicyMenu.push(p) %}{% endif %}{% endfor %}
{% if edPolicyMenu.length %}    <a href="{{ edPolicyMenu[0].url }}" {% if page.url == edPolicyMenu[0].url %}aria-current="page"{% endif %}>
      <span>Editorial policy</span>
    </a>
{% endif %}   {#
    <a href="/about/" aria-current="page">
      <span>About</span>
    </a>
#}
<a href="{{ station.editorUrl }}/{{ cmsConfig.group.name }}/login" {% if page.url == '/login' %}aria-current="page"{% endif %}>
      <span>Log in</span>
    </a>
  </nav>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = s => document.querySelector(s)
    const all = s => [...document.querySelectorAll(s)]
    const mainContainer = select('main') || select('#main-container')
    const dropdownControls = all('input.dropdown-btn')
    const menu_btn = select('#menu-btn')
    const topbar = select('#topbar')

    menu_btn.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault()
        menu_btn.click()
      }
    })
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menu_btn.checked) {
        menu_btn.click()
        menu_btn.focus()
      }
    })
    menu_btn.addEventListener('input', e => {
      const { checked } = e.target
      const method = checked ? 'add' : 'remove'
      topbar.classList[method]('hide-topbar')
      const transition = checked ? 'all 0.3s 0s' : 'all 0.3s 0.3s'
      topbar.style.transition = transition
    })
    const closeDropdown = checkbox => (checkbox.checked = false)
    const closeAll = () => dropdownControls.forEach(closeDropdown)

    const closeOthers = checkbox => {
      const others = dropdownControls.filter(curr => curr !== checkbox)
      others.forEach(closeDropdown)
    }

    mainContainer.addEventListener('click', closeAll)
    dropdownControls.forEach(checkbox => {
      checkbox.addEventListener('input', () => closeOthers(checkbox))
    })
  })
</script>
 