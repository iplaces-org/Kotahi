{% extends '../layouts/base.njk' %}
{% set currentPage = cmsPage %}
{% set title = cmsPage.title %}
{% block content %}
    <main>
        <h1 class="visually-hidden">{{ cmsPage.title }}</h1>
        <div class="page-content">
            {{ cmsPage.content | safe }}
        </div>
    </main>
{% endblock %}

{% block styles %}
  {{ super() }}
  <style>
    /* Centre the text column instead of fixed 335px side margins, which
       squeezed pages to one word per line on phones (WCAG 1.4.10 Reflow). */
    .page-content {
      max-width: 760px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
      box-sizing: border-box;
    }
  </style>
{% endblock %}
