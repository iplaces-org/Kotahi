.journal-issues { max-width: 760px; margin: 0 auto; }

.issue { margin: 0 0 2.75rem; }

.issue-header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid #1b1b1a;
}
.issue-volume {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6b66;
}
.issue-year {
    font-size: 1.55rem;
    font-weight: 600;
    margin: 0;
    line-height: 1;
}

.issue-articles { display: flex; flex-direction: column; }

.entry {
    padding: 0.95rem 0;
    border-bottom: 1px solid #e7e4dc;
}
.entry:last-child { border-bottom: none; }

.entry-title { font-size: 1.08rem; font-weight: 600; margin: 0.15rem 0 0.3rem; line-height: 1.3; }
.entry-title a { text-decoration: none; color: #1b1b1a; }
.entry-title a:hover { text-decoration: underline; }

.entry-authors { font-size: 0.9rem; color: #44443f; }
.entry-date { display: block; font-size: 0.8rem; color: #8a8a83; margin-top: 0.2rem; }

.type {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.16rem 0.5rem;
    border-radius: 3px;
}
  .gump-journal .tag-class    { background: #f3ecd8; color: #7a5410; }
  .gump-journal .tag-research { background: #e6f1fb; color: #185fa5; }
  .gump-journal .tag-conf     { background: #ece4f5; color: #5a3a86; }
  .gump-journal .tag-outreach { background: #e1f5ee; color: #0f6e56; }

.empty { color: #8a8a83; font-style: italic; }
.issue { max-width: 720px; margin: 0 auto 3rem; }

.issue-label {
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #6b6b66;
    margin: 0 0 0.25rem;
}
.issue-title {
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #d9d6cd;
}

.toc { list-style: none; margin: 0; padding: 0; }
.toc-item {
    padding: 0.85rem 0;
    border-bottom: 1px solid #ebe9e2;
}
.toc-title {
    display: block;
    font-size: 1.06rem;
    font-weight: 600;
    color: #1b1b1a;
    text-decoration: none;
    line-height: 1.35;
}
.toc-title:hover { text-decoration: underline; }
.toc-authors {
    display: block;
    font-size: 0.9rem;
    color: #55554f;
    margin-top: 0.2rem;
}

.tag {
    float: right;
    margin-left: 0.75rem;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 3px;
}
.tag-research  { background: #e6f1fb; color: #185fa5; }
.tag-education { background: #e1f5ee; color: #0f6e56; }
.tag-event     { background: #faece7; color: #993c1d; }

.issue-more { margin-top: 1.25rem; font-size: 0.95rem; }
.archive-title { font-size: 1.8rem; font-weight: 600; margin: 0 0 1.5rem; }

