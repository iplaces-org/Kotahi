---
layout: base.njk
class: section-latest
pagination:
  data: cmsCollections
  size: 1
  alias: pubCollection
permalink: "/collections/{{ pubCollection.formData.title | default('collection') | string | lower | replace('&', 'and') | replace(\"'\", '') | replace(',', '') | replace('.', '') | replace(':', '') | replace('(', '') | replace(')', '') | replace('/', '-') | trim | replace(' ', '-') }}/index.html"
---
{#- iPlaces: one page per active Kotahi collection (CMS > Collections).
    Members are the records picked in the collection; only published records show.
    Matches on shortId, falling back to the manuscript id, so it works whether Flax
    passes the collection's manuscripts as objects or as ids. -#}
{%- set wanted = [] -%}
{%- for m in (pubCollection.manuscripts or []) -%}
  {%- if m.shortId -%}{%- set wanted = wanted.concat([m.shortId, m.shortId | string]) -%}{%- endif -%}
  {%- if m.id -%}{%- set wanted = wanted.concat([m.id]) -%}{%- elif not m.shortId -%}{%- set wanted = wanted.concat([m]) -%}{%- endif -%}
{%- endfor -%}
<style>
  body.section-latest .page-content { padding-left: 0 !important; padding-right: 0 !important; }
  .toc { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .toc-header { display: flex; gap: 1.75rem; align-items: flex-start; padding-bottom: 1.5rem; border-bottom: 2px solid #1b1b1a; margin-bottom: 2rem; }
  .toc-cover { flex-shrink: 0; }
  .toc-cover img { width: 172px; height: 172px; object-fit: cover; display: block; border: 1px solid #d6d3d1; }
  .toc-head-text { flex: 1; }
  .toc-eyebrow { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #6b6b63; margin: 0 0 0.4rem; }
  .toc-title { font-family: Georgia, "Times New Roman", serif; font-size: 2rem; font-weight: 600; line-height: 1.1; margin: 0 0 0.75rem; color: #1b1b1a; }
  .toc-blurb { font-size: 0.9rem; color: #57534e; line-height: 1.55; margin: 0 0 1rem; }
  .toc-actions a { font-size: 0.8rem; color: #185fa5; text-decoration: none; margin-right: 1.25rem; }
  .toc-actions a:hover { text-decoration: underline; }
  .toc-entry { padding: 1rem 0; border-bottom: 1px solid #e9e7df; }
  .toc-entry:last-child { border-bottom: none; }
  .toc-entry-title { font-size: 1.1rem; font-weight: 600; line-height: 1.3; margin: 0 0 0.3rem; }
  .toc-entry-title a { color: #1b1b1a; text-decoration: none; }
  .toc-entry-title a:hover { text-decoration: underline; }
  .toc-entry-byline { font-size: 0.82rem; color: #57534e; margin: 0 0 0.4rem; }
  .toc-entry-byline .toc-date { color: #6b6b63; }
  .toc-entry-summary { font-size: 0.9rem; color: #57534e; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .toc-empty { color: #6b6b63; font-style: italic; }
  @media (max-width: 700px) {
    .toc { padding: 1.5rem 1.1rem 3rem; }
    .toc-header { flex-direction: column; gap: 1rem; }
  }
</style>

<div class="toc">
  <div class="toc-header">
    {% if pubCollection.formData.image %}
    <div class="toc-cover">
      <img src="{{ pubCollection.formData.image }}" alt="" onerror="this.parentNode.style.display='none'">
    </div>
    {% endif %}
    <div class="toc-head-text">
      <p class="toc-eyebrow">Collection</p>
      <h1 class="toc-title">{{ pubCollection.formData.title }}</h1>
      {% if pubCollection.formData.description %}<p class="toc-blurb">{{ pubCollection.formData.description | safe }}</p>{% endif %}
      <p class="toc-actions"><a href="../">All collections &rarr;</a><a href="../../browse/">Browse all works &rarr;</a></p>
    </div>
  </div>

{% set shown = 0 %}
{% set sortedArticles = (articleQuery.articles or []) | sort(true, false, 'parsedSubmission.datePublished') %}
{% for a in sortedArticles %}
  {% if (a.shortId in wanted) or (a.id and (a.id in wanted)) %}
    {% set shown = shown + 1 %}
    <div class="toc-entry">
      <h2 class="toc-entry-title">
        <a href="{{ cmsConfig.defaultArticleDirectory }}{{ a.shortId }}/index.html">{{ a.headerInfo.title | safe }}</a>
      </h2>
      <p class="toc-entry-byline">
        {% for au in a.headerInfo.authorNames %}{{ au.firstName }}{% if au.middleName %} {{ au.middleName }}{% endif %} {{ au.lastName }}{% if not loop.last %}, {% endif %}{% endfor %}
        {% if a.parsedSubmission.datePublished %}<span class="toc-date">&middot; {{ a.parsedSubmission.datePublished }}</span>{% endif %}
      </p>
      {% if a.parsedSubmission.$abstract %}<div class="toc-entry-summary">{{ a.parsedSubmission.$abstract | striptags | truncate(400) }}</div>{% endif %}
    </div>
  {% endif %}
{% endfor %}
{% if shown == 0 %}
  <p class="toc-empty">No published records in this collection yet.</p>
{% endif %}
</div>
