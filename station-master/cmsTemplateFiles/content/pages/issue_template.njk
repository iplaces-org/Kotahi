---
layout: base.njk
class: section-latest
pagination:
  data: issues.list
  size: 1
  alias: issue
permalink: "/issue/{{ issue.slug }}/index.html"
---

<style>
  body.section-latest .page-content { padding-left: 0 !important; padding-right: 0 !important; }
  .toc { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .toc-header { display: flex; gap: 1.75rem; align-items: flex-start; padding-bottom: 1.5rem; border-bottom: 2px solid #1b1b1a; margin-bottom: 2rem; }
  .toc-cover { flex-shrink: 0; }
  .toc-cover img { width: 172px; height: 226px; object-fit: cover; display: block; border: 1px solid #d6d3d1; }
  .toc-head-text { flex: 1; }
  .toc-eyebrow { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #78716c; margin: 0 0 0.4rem; }
  .toc-title { font-family: Georgia, "Times New Roman", serif; font-size: 2rem; font-weight: 600; line-height: 1.1; margin: 0 0 0.5rem; color: #1b1b1a; }
  .toc-issue-line { font-size: 1rem; font-weight: 600; color: #1c1917; margin: 0 0 0.75rem; }
  .toc-blurb { font-size: 0.9rem; color: #57534e; line-height: 1.55; margin: 0 0 1rem; }
  .toc-actions a { font-size: 0.8rem; color: #185fa5; text-decoration: none; margin-right: 1.25rem; }
  .toc-actions a:hover { text-decoration: underline; }
  .toc-section { margin: 0 0 2.5rem; }
  .toc-section-head { font-family: Georgia, serif; font-size: 1.35rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; color: #1b1b1a; padding-bottom: 0.4rem; border-bottom: 1px solid #1b1b1a; margin: 0 0 1rem; }
  .toc-entry { padding: 1rem 0; border-bottom: 1px solid #e9e7df; }
  .toc-entry:last-child { border-bottom: none; }
  .toc-entry-title { font-size: 1.1rem; font-weight: 600; line-height: 1.3; margin: 0 0 0.3rem; }
  .toc-entry-title a { color: #1b1b1a; text-decoration: none; }
  .toc-entry-title a:hover { text-decoration: underline; }
  .toc-entry-byline { font-size: 0.82rem; color: #57534e; margin: 0 0 0.4rem; }
  .toc-entry-byline .toc-date { color: #8a8a83; }
  .toc-entry-summary { font-size: 0.9rem; color: #57534e; line-height: 1.5; margin: 0; }
  .toc-empty { color: #8a8a83; font-style: italic; }
  @media (max-width: 700px) {
    .toc { padding: 1.5rem 1.1rem 3rem; }
    .toc-header { flex-direction: column; gap: 1rem; }
    .toc-cover { width: 160px; }
  }
</style>

<div class="toc">
{% if articleQuery.articles.length > 0 %}
{% set sortedArticles = articleQuery.articles | sort(true, false, 'parsedSubmission.datePublished') %}

  <div class="toc-header">
    <div class="toc-cover">
      <img src="{{ issue.cover }}" alt="{{ issue.label }}" onerror="this.parentNode.style.display='none'">
    </div>
    <div class="toc-head-text">
      <p class="toc-eyebrow">{{ issue.eyebrow }}</p>
      <h1 class="toc-title">{{ issue.label }}</h1>
      <p class="toc-issue-line">{{ issue.dateline }}</p>
      {% if issue.blurb %}<p class="toc-blurb">{{ issue.blurb | safe }}</p>{% endif %}
      <p class="toc-actions"><a href="../../browse/">Browse all works &rarr;</a></p>
    </div>
  </div>

  {% for section in issues.sections %}
    {% set sectokens = section.tokens | default([section.key]) %}
    {% set ids = [] %}
    {% for a in sortedArticles %}
      {% set yr = (a.parsedSubmission.datePublished | default("") | string) | truncate(4, true, "") %}
      {% set inIssue = false %}
      {% if issue.match.type == "year"   and yr == issue.match.year %}{% set inIssue = true %}{% endif %}
      {% if issue.match.type == "before" and yr <  issue.match.year %}{% set inIssue = true %}{% endif %}
      {% if issue.match.type == "range"  and yr >= issue.match.from and yr <= issue.match.to %}{% set inIssue = true %}{% endif %}
      {% if inIssue %}
        {% set raw  = (a.parsedSubmission.topics | default("")) | string | lower %}
        {% set toks = raw | replace(" ", "") | replace("[", "") | replace("]", "") | replace('"', "") | replace("'", "") %}
        {% set hit = false %}
        {% for tok in toks.split(",") %}
          {% if tok in sectokens %}{% set hit = true %}{% endif %}
        {% endfor %}
        {% if hit and not (a.shortId in ids) %}{% set ids = ids.concat([a.shortId]) %}{% endif %}
      {% endif %}
    {% endfor %}

    {% if ids.length > 0 %}
      <div class="toc-section">
        <h2 class="toc-section-head">{{ section.label }}</h2>
        {% for a in sortedArticles %}
          {% if a.shortId in ids %}
            <div class="toc-entry">
              <h3 class="toc-entry-title">
                <a href="{{ cmsConfig.defaultArticleDirectory }}{{ a.shortId }}/index.html">{{ a.headerInfo.title | safe }}</a>
              </h3>
              <p class="toc-entry-byline">
                {% for au in a.headerInfo.authorNames %}{{ au.firstName }}{% if au.middleName %} {{ au.middleName }}{% endif %} {{ au.lastName }}{% if not loop.last %}, {% endif %}{% endfor %}
                <span class="toc-date">&middot; {{ a.parsedSubmission.datePublished | default("") }}</span>
              </p>
              {% if a.parsedSubmission.$abstract %}<p class="toc-entry-summary">{{ a.parsedSubmission.$abstract | safe }}</p>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

{% else %}
  <p class="toc-empty">No articles published yet.</p>
{% endif %}
</div>