---
layout: base.njk
class: section-latest
permalink: "/collections/index.html"
---
{#- iPlaces: lists the station's active Kotahi collections (CMS > Collections).
    Each one gets its own page from collection_template.njk. The menu and cover
    only link here when the station has at least one active collection. -#}
{%- set colls = cmsCollections or [] -%}
<style>
  body.section-latest .page-content { padding-left: 0 !important; padding-right: 0 !important; }
  .collections-page { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .collections-page .page-title { font-family: Georgia, "Times New Roman", serif; font-size: 2rem; font-weight: 600; margin: 0 0 0.4rem; color: #1b1b1a; }
  .collections-page .page-intro { font-size: 0.9rem; color: #57534e; line-height: 1.55; margin: 0 0 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid #1b1b1a; }
  .collections-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .collection-card { text-decoration: none; color: inherit; display: block; }
  .collection-card:hover .card-title { text-decoration: underline; }
  .collection-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; margin-bottom: 0.75rem; border: 1px solid #e7e5e4; }
  .card-type { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: #6b6b63; margin: 0 0 0.25rem; }
  .card-title { font-family: Georgia, "Times New Roman", serif; font-size: 1.2rem; font-weight: 600; line-height: 1.3; color: #1b1b1a; margin: 0 0 0.5rem; }
  .card-desc { font-size: 0.875rem; color: #57534e; line-height: 1.55; margin: 0; }
  .collections-empty { color: #6b6b63; font-style: italic; }
  @media (max-width: 600px) { .collections-grid { grid-template-columns: 1fr; } .collections-page { padding: 1.5rem 1.1rem 3rem; } }
</style>
<div class="collections-page">
  <h1 class="page-title">Collections</h1>
  <p class="page-intro">Records from {{ station.shortName or station.title or "this station" }} gathered around a shared subject, place, or funder.</p>
{% if colls.length %}
  <div class="collections-grid">
  {% for c in colls %}
    {%- set ctitle = (c.formData.title or "Collection") | string -%}
    {%- set cslug = ctitle | lower | replace("&", "and") | replace("'", "") | replace(",", "") | replace(".", "") | replace(":", "") | replace("(", "") | replace(")", "") | replace("/", "-") | trim | replace(" ", "-") -%}
    {%- set ccount = (c.manuscripts or []).length -%}
    <a class="collection-card" href="/collections/{{ cslug }}/">
      {% if c.formData.image %}<img src="{{ c.formData.image }}" alt="" onerror="this.style.display='none'">{% endif %}
      <p class="card-type">Collection{% if ccount %} &middot; {{ ccount }} record{% if ccount != 1 %}s{% endif %}{% endif %}</p>
      <h2 class="card-title">{{ ctitle }}</h2>
      {% if c.formData.description %}<p class="card-desc">{{ c.formData.description | safe }}</p>{% endif %}
    </a>
  {% endfor %}
  </div>
{% else %}
  <p class="collections-empty">No collections yet.</p>
{% endif %}
</div>
