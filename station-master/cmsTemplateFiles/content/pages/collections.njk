---
layout: base.njk
class: section-latest
permalink: "/collections/index.html"
---
{#- iPlaces: the station's collections, one section each, at /collections/#<slug>.
    Defined in station.json "collections" (manifest stationJson):
      [{ "slug": "sea-turtles", "title": "...", "description": "...", "shortIds": [11, 16] }]
    No pagination on purpose: a paginated template fails the build on stations
    whose data has no collections. Only published records show (articleQuery). -#}
{%- set colls = station.collections or [] -%}
{%- set sortedArticles = (articleQuery.articles or []) | sort(true, false, 'parsedSubmission.datePublished') -%}
<style>
  body.section-latest .page-content { padding-left: 0 !important; padding-right: 0 !important; }
  .toc { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  .toc .page-title { font-family: Georgia, "Times New Roman", serif; font-size: 2rem; font-weight: 600; margin: 0 0 0.4rem; color: #1b1b1a; }
  .toc .page-intro { font-size: 0.9rem; color: #57534e; line-height: 1.55; margin: 0 0 1.25rem; }
  .coll-jump { list-style: none; margin: 0 0 2.5rem; padding: 0 0 1.5rem; border-bottom: 2px solid #1b1b1a; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .coll-jump a { font-size: 0.9rem; color: #185fa5; text-decoration: none; }
  .coll-jump a:hover { text-decoration: underline; }
  .coll-jump .coll-count { color: #6b6b63; font-size: 0.8rem; }
  .toc-section { margin: 0 0 3rem; scroll-margin-top: 5rem; }
  .toc-eyebrow { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #6b6b63; margin: 0 0 0.3rem; }
  .toc-section-head { font-family: Georgia, "Times New Roman", serif; font-size: 1.6rem; font-weight: 600; line-height: 1.15; color: #1b1b1a; margin: 0 0 0.5rem; }
  .toc-blurb { font-size: 0.9rem; color: #57534e; line-height: 1.55; margin: 0 0 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px solid #1b1b1a; }
  .toc-entry { padding: 1rem 0; border-bottom: 1px solid #e9e7df; }
  .toc-entry:last-child { border-bottom: none; }
  .toc-entry-title { font-size: 1.1rem; font-weight: 600; line-height: 1.3; margin: 0 0 0.3rem; }
  .toc-entry-title a { color: #1b1b1a; text-decoration: none; }
  .toc-entry-title a:hover { text-decoration: underline; }
  .toc-entry-byline { font-size: 0.82rem; color: #57534e; margin: 0 0 0.4rem; }
  .toc-entry-byline .toc-date { color: #6b6b63; }
  .toc-entry-summary { font-size: 0.9rem; color: #57534e; line-height: 1.5; margin: 0; }
  .toc-empty { color: #6b6b63; font-style: italic; }
  @media (max-width: 700px) { .toc { padding: 1.5rem 1.1rem 3rem; } }
</style>

<div class="toc">
  <h1 class="page-title">Collections</h1>
  <p class="page-intro">Records from {{ station.shortName or station.title or "this station" }} gathered around a shared subject, place, or funder.</p>
{% if colls.length %}
  <ul class="coll-jump">
  {% for c in colls %}
    {%- set n = 0 -%}{%- for a in sortedArticles -%}{%- if (a.shortId in (c.shortIds or [])) -%}{%- set n = n + 1 -%}{%- endif -%}{%- endfor -%}
    <li><a href="#{{ c.slug }}">{{ c.title }}</a> <span class="coll-count">{{ n }}</span></li>
  {% endfor %}
  </ul>

  {% for c in colls %}
  <section class="toc-section" id="{{ c.slug }}">
    <p class="toc-eyebrow">Collection</p>
    <h2 class="toc-section-head">{{ c.title }}</h2>
    {% if c.description %}<p class="toc-blurb">{{ c.description | safe }}</p>{% endif %}
    {% set shown = 0 %}
    {% for a in sortedArticles %}
      {% if a.shortId in (c.shortIds or []) %}
        {% set shown = shown + 1 %}
        <div class="toc-entry">
          <h3 class="toc-entry-title">
            <a href="{{ cmsConfig.defaultArticleDirectory }}{{ a.shortId }}/index.html">{{ a.headerInfo.title | safe }}</a>
          </h3>
          <p class="toc-entry-byline">
            {% for au in a.headerInfo.authorNames %}{{ au.firstName }}{% if au.middleName %} {{ au.middleName }}{% endif %} {{ au.lastName }}{% if not loop.last %}, {% endif %}{% endfor %}
            {% if a.parsedSubmission.datePublished %}<span class="toc-date">&middot; {{ a.parsedSubmission.datePublished }}</span>{% endif %}
          </p>
          {% if a.parsedSubmission.$abstract %}<p class="toc-entry-summary">{{ a.parsedSubmission.$abstract | striptags | truncate(300) }}</p>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
    {% if shown == 0 %}<p class="toc-empty">No published records in this collection yet.</p>{% endif %}
  </section>
  {% endfor %}
{% else %}
  <p class="toc-empty">No collections yet.</p>
{% endif %}
</div>
